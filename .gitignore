# Secrets and signing material never enter this repository
*.env
.env*
!.env.example
*.p12
*.pfx
*.cer
*.mobileprovision
signing/
azure-signing*

# macOS / Swift
.DS_Store
.build/
.swiftpm/
*.xcuserstate
xcuserdata/
DerivedData/
*.app
*.dmg
*.zip

# Windows / .NET
bin/
obj/
publish*/
installer-output/
*.user
*.suo
.vs/
AppPackages/

# Local models, media and caches
*.onnx
# The Windows face models, bundled and hash-checked (ADR-R48 Windows; apps/windows/models/frames/NOTICE.txt).
!apps/windows/models/frames/*.onnx
*.bin
*.mp4
*.mov
*.wav
!shared/fixtures/**/*.wav
# The bundled CC0 sound effects (tools/media/sfx/gen_sfx.py, doc/spec/ai.md section 18.5).
!shared/data/sfx/*.wav
!shared/fixtures/**/*.mp4
!shared/fixtures/**/*.mov
node_modules/

# Python and release outputs
__pycache__/
*.pyc
apps/macos/dist/
apps/windows/dist/
*.tar
*.tar.xz

# Static launch-page output and local release metadata
site/dist/
site/latest.json
