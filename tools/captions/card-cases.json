{
  "description": "Inputs for shared/fixtures/captions/cards.json (gen_cards.py). A project is a stored fixture project (file), another project with an RFC 7396 patch (from), or a synthetic take built on the template: words are spaced 0.45 s apart and 0.35 s long unless times are given; cut, cutPauses and clip bounds name word ids w1, w2, ...",
  "template": "shared/fixtures/projects/interview-take.voxclip",
  "projects": {
    "interview-take": {"file": "shared/fixtures/projects/interview-take.voxclip"},
    "interview-off": {"from": "interview-take", "patch": {"captions": {"styleId": "off"}}},
    "interview-karaoke": {"from": "interview-take", "patch": {"captions": {"styleId": "karaoke"}}},
    "long-take": {"file": "shared/fixtures/projects/clip-from-long-take.voxclip"},
    "filler-opening": {"title": "Latte art basics", "language": "en", "style": "karaoke",
      "words": "Um, so, okay… latte art for beginners is mostly patience."},
    "fillers-only": {"title": "Warm-up", "language": "en", "style": "karaoke", "words": "Um. Uh."},
    "number-opening": {"title": "Grinder shootout", "language": "en", "style": "two-tone", "video": false, "aspect": "source",
      "words": "We tested 12 grinders for 3 weeks."},
    "estonian": {"title": "Öine küpsetamine", "language": "et", "style": "box-highlight",
      "words": "Öösel küpsetatud šokolaadikook on päris hõrk."},
    "long-word": {"title": "Sünnipäev", "language": "et", "style": "vox-highlight",
      "words": "Sünnipäevakingitusteostmisvõimalused on lõputud."},
    "long-word-subtitle": {"from": "long-word", "patch": {"captions": {"styleId": "clean-subtitle"}}},
    "cut-start": {"title": "Pour-over in four steps", "language": "en", "style": "pill", "cut": ["w1", "w2"],
      "words": "Okay so first the beans then the water."},
    "cafe-clip": {"title": "Espresso machines", "language": "en", "style": "neon", "cut": ["w3"],
      "clips": [{"id": "clip-compare", "start": "w3", "end": "w11", "title": "Two machines"}],
      "words": "Welcome back. Today we compare two espresso machines side by side."},
    "cafe-keep": {"from": "cafe-clip", "patch": {"captions": {"styleId": "active-pop", "overrides": {"text": {"punctuation": "keep"}}}}},
    "all-cut-clip": {"title": "Milk first", "language": "en", "style": "karaoke", "cut": ["w1", "w2"],
      "clips": [{"id": "clip-coffee", "start": "w1", "end": "w2", "title": "Coffee first"}],
      "words": "Coffee first. Then we talk about milk."},
    "gap": {"title": "Beans", "language": "en", "style": "karaoke",
      "words": "Coffee beans matter most today.", "times": [[0.2, 0.6], [0.7, 1.1], [2.6, 3.0], [3.1, 3.5], [3.6, 4.1]]},
    "gap-cut": {"from": "gap", "patch": {"edits": {"cutPauseIds": ["pause-after-w2"]}}},
    "german": {"title": "Kaffeepause", "language": "de", "style": "karaoke", "words": "Um zehn Uhr trinken wir Kaffee."},
    "uncovered": {"title": "Morning", "language": "en", "style": "emoji-accent", "words": "こんにちは 🔥 Great coffee today."},
    "empty-transcript": {"title": "Silent take", "language": "en", "style": "karaoke", "words": ""},
    "never-transcribed": {"title": "Studio tour", "language": "en", "style": "karaoke", "transcript": false},
    "untitled": {"title": null, "language": "en", "style": "karaoke", "words": "Coffee first."},
    "style-matrix": {"title": "Barista lessons", "language": "en", "style": "karaoke",
      "words": "Here's what 3 baristas taught me, honestly."},
    "as-said": {"from": "style-matrix", "patch": {"captions": {"overrides": {"text": {"transform": "none"}}}}},
    "one-word-override": {"from": "style-matrix", "patch": {"captions": {"styleId": "box-highlight", "overrides": {"layout": {"maxWords": 1, "maxLines": 1}}}}},
    "line-override": {"from": "style-matrix", "patch": {"captions": {"styleId": "pill", "overrides": {"layout": {"maxWords": 16, "maxLines": 1}}}}},
    "rejected-override": {"from": "style-matrix", "patch": {"captions": {"overrides": {"layout": {"maxWords": 99}}}}}
  },
  "cases": [
    {"id": "interview-take", "project": "interview-take"},
    {"id": "interview-take-words-hidden", "project": "interview-take", "wordsVisible": false},
    {"id": "interview-take-title-number", "project": "interview-karaoke", "wordsVisible": false},
    {"id": "interview-captions-off", "project": "interview-off", "style": "vox-highlight"},
    {"id": "long-take", "project": "long-take"},
    {"id": "long-take-clip-2f1c", "project": "long-take", "scope": "clip-2f1c"},
    {"id": "long-take-clip-9a0b", "project": "long-take", "scope": "clip-9a0b"},
    {"id": "long-take-clip-words-hidden", "project": "long-take", "scope": "clip-9a0b", "wordsVisible": false},
    {"id": "filler-opening", "project": "filler-opening"},
    {"id": "fillers-only", "project": "fillers-only"},
    {"id": "number-opening", "project": "number-opening"},
    {"id": "estonian", "project": "estonian"},
    {"id": "long-word", "project": "long-word"},
    {"id": "long-word-subtitle", "project": "long-word-subtitle"},
    {"id": "cut-start", "project": "cut-start"},
    {"id": "clip-full-take", "project": "cafe-clip"},
    {"id": "clip-cut-start", "project": "cafe-clip", "scope": "clip-compare"},
    {"id": "keep-punctuation", "project": "cafe-keep"},
    {"id": "all-cut-clip", "project": "all-cut-clip", "scope": "clip-coffee"},
    {"id": "all-cut-clip-full-take", "project": "all-cut-clip"},
    {"id": "gap-breaks-page", "project": "gap"},
    {"id": "cut-pause-joins-page", "project": "gap-cut"},
    {"id": "no-stopword-list", "project": "german"},
    {"id": "uncovered-words", "project": "uncovered"},
    {"id": "empty-transcript", "project": "empty-transcript"},
    {"id": "empty-transcript-words-hidden", "project": "empty-transcript", "wordsVisible": false},
    {"id": "never-transcribed", "project": "never-transcribed"},
    {"id": "untitled-words-hidden", "project": "untitled", "wordsVisible": false},
    {"id": "as-said-override", "project": "as-said"},
    {"id": "one-word-override", "project": "one-word-override"},
    {"id": "line-override", "project": "line-override"},
    {"id": "rejected-override", "project": "rejected-override"}
  ],
  "matrix": {"project": "style-matrix", "prefix": "style"}
}
