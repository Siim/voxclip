<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows half of the face calibration (tools/frames/calibrate, ADR-R48 Windows, W7): the shipped C# face path on the
       calibration's decoded frames, on the Mac host. A developer tool: it is not part of the solution and never ships. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>voxclip-face-calibration</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../apps/windows/src/VoxClip.Media/VoxClip.Media.csproj" />
  </ItemGroup>
</Project>
