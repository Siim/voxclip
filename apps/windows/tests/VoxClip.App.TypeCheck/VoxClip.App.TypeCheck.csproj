<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Library</OutputType>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <UseWinUI>false</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <ExpandPriResources>false</ExpandPriResources>
    <RootNamespace>VoxClip.App</RootNamespace>
    <AssemblyName>VoxClip.WinCheck</AssemblyName>
    <AppDir>$(MSBuildThisFileDirectory)../../src/VoxClip.App</AppDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(AppDir)/**/*.cs" Exclude="$(AppDir)/obj/**;$(AppDir)/bin/**" />
    <Compile Include="$(IntermediateOutputPath)Generated.g.cs" />
    <ProjectReference Include="../../src/VoxClip.Core/VoxClip.Core.csproj" />
    <ProjectReference Include="../../src/VoxClip.Media/VoxClip.Media.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <Target Name="GenerateXamlMemberStubs" BeforeTargets="BeforeCompile">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)generate.py&quot; &quot;$(AppDir)&quot; &quot;$(IntermediateOutputPath)Generated.g.cs&quot;" />
  </Target>
</Project>
