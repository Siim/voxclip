<Page x:Class="VoxClip.App.Pages.EditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:VoxClip.App.Controls" xmlns:local="using:VoxClip.App.Pages" xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
    <!-- Rows (delta §3.3): the command row (56), the work area and the timeline (72). -->
    <Grid x:Name="EditorRoot" KeyDown="EditorKeyDown" SizeChanged="EditorSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <!-- Command row (delta §3.5): the title over the edit summary, the commands, then the one accent Export. -->
        <Grid x:Name="CommandRow" Padding="16,0" ColumnSpacing="12" BorderBrush="{ThemeResource VcLineDefaultBrush}" BorderThickness="0,0,0,1">
            <!-- The bar takes the star column so its dynamic overflow sees the room it has; the heading truncates past 360. -->
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="360"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" FontSize="18" LineHeight="24" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Text="{x:Bind ViewModel.SummaryLine, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.SummaryTooltip, Mode=OneWay}" FontSize="12" LineHeight="16"
                    Foreground="{ThemeResource VcTextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <CommandBar x:Name="Commands" Grid.Column="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Right">
                <CommandBar.Resources>
                    <ResourceDictionary>
                        <!-- The checked Viewer toggle takes the subtle fill, so the page keeps one accent block (delta §3.5). -->
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default">
                                <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Light">
                                <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush"/>
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast">
                                <StaticResource x:Key="AppBarToggleButtonBackgroundChecked" ResourceKey="SystemColorHighlightColorBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPointerOver" ResourceKey="SystemColorHighlightColorBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonBackgroundCheckedPressed" ResourceKey="SystemColorHighlightColorBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemColorHighlightTextColorBrush"/>
                                <StaticResource x:Key="AppBarToggleButtonForegroundCheckedPressed" ResourceKey="SystemColorHighlightTextColorBrush"/>
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </CommandBar.Resources>
                <!-- Restore cuts, then Tighten pauses, move to the overflow first as the row narrows (delta §3.7). -->
                <AppBarButton Icon="Cut" Label="{x:Bind ViewModel.FillerLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.Summary.CanCutFillers, Mode=OneWay}" Click="FillersClicked" ToolTipService.ToolTip="Cut fillers (Ctrl+Shift+U)" DynamicOverflowOrder="3"/>
                <AppBarButton Icon="Clock" Label="Tighten pauses" IsEnabled="{x:Bind ViewModel.Summary.CanTighten, Mode=OneWay}" Click="PausesClicked" ToolTipService.ToolTip="Tighten pauses (Ctrl+Shift+P)" DynamicOverflowOrder="2"/>
                <AppBarButton Icon="Undo" Label="Restore cuts" IsEnabled="{x:Bind ViewModel.Summary.HasEdits, Mode=OneWay}" Click="RestoreClicked" ToolTipService.ToolTip="Restore cuts (Ctrl+Shift+R)" DynamicOverflowOrder="1"/>
                <AppBarSeparator/>
                <AppBarButton x:Name="FindClipsCommand" Label="Find clips" Click="FindClipsClicked" ToolTipService.ToolTip="Find clips (Ctrl+Shift+K)" DynamicOverflowOrder="4">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE721;"/></AppBarButton.Icon>
                </AppBarButton>
                <AppBarElementContainer x:Name="FindClipsBusyHost" Visibility="Collapsed">
                    <ProgressRing x:Name="FindClipsBusy" Width="16" Height="16" Margin="4,0" IsActive="False" Foreground="{ThemeResource VcAccentTextBrush}" AutomationProperties.Name="Finish the current task first."/>
                </AppBarElementContainer>
                <AppBarToggleButton x:Name="Viewer" Icon="OpenPane" Label="Viewer" IsChecked="True" Click="ViewerClicked" ToolTipService.ToolTip="Show or hide the viewer (Ctrl+Shift+I)" DynamicOverflowOrder="5"/>
                <CommandBar.SecondaryCommands>
                    <AppBarButton x:Name="MakeClipCommand" Label="Make clip" KeyboardAcceleratorTextOverride="Ctrl+K" IsEnabled="False" Click="MakeClipClicked"/>
                    <AppBarButton x:Name="RewriteCommand" Label="Rewrite…" KeyboardAcceleratorTextOverride="Ctrl+R" IsEnabled="False" Visibility="Collapsed" Click="RewriteClicked"/>
                    <AppBarButton Label="Cut selection" KeyboardAcceleratorTextOverride="Delete" Click="CutSelectionClicked"/>
                    <AppBarButton Label="Restore selection" KeyboardAcceleratorTextOverride="Shift+Backspace" Click="RestoreSelectionClicked"/>
                    <AppBarButton Label="Correct spelling…" KeyboardAcceleratorTextOverride="Enter" Click="CorrectClicked"/>
                    <AppBarButton Label="Play from here" KeyboardAcceleratorTextOverride="Shift+Space" Click="PlayFromHereClicked"/>
                    <AppBarButton x:Name="PreviewCutCommand" Label="Preview This Cut" KeyboardAcceleratorTextOverride="P" IsEnabled="False" Click="PreviewCutClicked"/>
                    <AppBarButton Label="Forward 3 seconds" Click="ForwardClicked"/>
                    <AppBarToggleButton x:Name="ShowCuts" Label="Show cut words" KeyboardAcceleratorTextOverride="Ctrl+Shift+H" IsChecked="True" Click="DisplayChanged"/>
                    <AppBarToggleButton x:Name="ShowPauses" Label="Show pauses" IsChecked="True" Click="DisplayChanged"/>
                    <AppBarButton Label="Find" KeyboardAcceleratorTextOverride="Ctrl+F" Click="FindClicked"/>
                    <AppBarButton Label="Undo" KeyboardAcceleratorTextOverride="Ctrl+Z" Click="UndoClicked"/>
                    <AppBarButton Label="Redo" KeyboardAcceleratorTextOverride="Ctrl+Y" Click="RedoClicked"/>
                    <AppBarSeparator/>
                    <AppBarButton Label="Save project as…" Click="SaveAsClicked"/>
                    <AppBarButton Label="Show project file" Click="ShowProjectClicked"/>
                    <AppBarButton Label="Transcribe again…" Click="TranscribeAgainClicked"/>
                    <AppBarButton Label="Keyboard shortcuts" KeyboardAcceleratorTextOverride="F1" Click="ShortcutsClicked"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <!-- A disabled button shows no tooltip, so the reason sits on this host. -->
            <Border x:Name="ExportHost" Grid.Column="2" Background="Transparent" VerticalAlignment="Center">
                <Button x:Name="ExportButton" Content="Export video…" Style="{StaticResource AccentButtonStyle}" Height="40" Padding="16,0" CornerRadius="{StaticResource VcRadiusControlCornerRadius}" Click="ExportClicked"/>
            </Border>
        </Grid>
        <!-- Work area (delta §3.3): the transcript, the viewer splitter, then the right column (300-560). -->
        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TranscriptColumn" Width="*" MinWidth="{StaticResource VcLayoutTranscriptMinWidth}"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightColumn" Width="388" MinWidth="{StaticResource VcSizeRightColumnMin}" MaxWidth="{StaticResource VcSizeRightColumnMax}"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="TranscriptPane" RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="EditorNotice" IsOpen="{x:Bind local:EditorPage.HasText(ViewModel.Notice), Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Severity="Warning">
                    <InfoBar.ActionButton><HyperlinkButton x:Name="LocateMedia" Content="Locate…" Click="LocateClicked" Visibility="Collapsed"/></InfoBar.ActionButton>
                </InfoBar>
                <StackPanel x:Name="FindBar" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="24,8,24,0" Visibility="Collapsed">
                    <TextBox x:Name="SearchText" Header="Find words" Width="160" TextChanged="SearchChanged"/>
                    <Button x:Name="CutMatches" Content="Cut all matches" VerticalAlignment="Bottom" Click="CutMatchesClicked"/>
                    <Button Content="Close" VerticalAlignment="Bottom" Click="CloseFindClicked"/>
                </StackPanel>
                <controls:TranscriptView x:Name="Transcript" Grid.Row="2"/>
                <StackPanel x:Name="Untranscribed" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="12" Padding="24">
                    <TextBlock Text="This video isn't transcribed yet." TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Choose on this PC or ElevenLabs to turn the video into words. Then select words to make a clip, or use Find clips." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button Content="Choose Transcription…" Click="TranscribeClicked" AutomationProperties.Name="Choose local or cloud transcription" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>
            <!-- 12 wide with a 4x28 grip; arrow keys step 16 and Enter collapses the viewer. -->
            <toolkit:GridSplitter x:Name="ViewerSplitter" Grid.Column="1" Width="12" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" KeyboardIncrement="16"
                AutomationProperties.Name="Resize viewer" KeyDown="SplitterKeyDown" KeyUp="SplitterKeyUp" ManipulationCompleted="SplitterDragged">
                <toolkit:GridSplitter.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Default"><StaticResource x:Key="SizerBaseForeground" ResourceKey="VcLineStrongBrush"/></ResourceDictionary>
                            <ResourceDictionary x:Key="Light"><StaticResource x:Key="SizerBaseForeground" ResourceKey="VcLineStrongBrush"/></ResourceDictionary>
                            <ResourceDictionary x:Key="HighContrast"><StaticResource x:Key="SizerBaseForeground" ResourceKey="SystemColorWindowTextColorBrush"/></ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                        <x:Double x:Key="SizerBaseThumbWidth">4</x:Double>
                        <x:Double x:Key="SizerBaseThumbHeight">28</x:Double>
                    </ResourceDictionary>
                </toolkit:GridSplitter.Resources>
            </toolkit:GridSplitter>
            <!-- Right column (delta §3.6): the viewer, a hairline, then Captions filling the rest. -->
            <Grid x:Name="RightPane" Grid.Column="2" BorderBrush="{ThemeResource VcLineDefaultBrush}" BorderThickness="1,0,0,0" SizeChanged="RightPaneSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="PreviewPane" Padding="16,16,16,0" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                    <Border x:Name="PreviewStage" Background="{ThemeResource VcStageBrush}" RequestedTheme="Dark" CornerRadius="{StaticResource VcRadiusPaneCornerRadius}" Height="200" HorizontalAlignment="Center">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Video preview, full take"/>
                            <StackPanel x:Name="PreviewStandIn" Margin="20" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <Grid x:Name="PreviewStateGlyphHost" Width="20" Height="20" HorizontalAlignment="Center">
                                    <FontIcon x:Name="PreviewStateGlyph" FontSize="20" Foreground="{ThemeResource VcChipWarningGlyphBrush}"/>
                                    <Line x:Name="PreviewMissingStrike" X1="1.5" Y1="1.5" X2="18.5" Y2="18.5" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{ThemeResource VcChipWarningGlyphBrush}"/>
                                </Grid>
                                <TextBlock x:Name="PreviewEmpty" FontSize="14" LineHeight="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource VcChipMediaForegroundBrush}"/>
                                <TextBlock x:Name="PreviewFile" TextWrapping="Wrap" TextAlignment="Center" FontFamily="{StaticResource VcMonoFontFamily}" FontSize="12" Opacity="0.66" Foreground="{ThemeResource VcChipMediaForegroundBrush}"/>
                            </StackPanel>
                            <controls:CaptionPositionOverlay x:Name="CaptionDrag"/>
                        </Grid>
                    </Border>
                    <!-- Viewer bar (delta §5.1): Back 3 seconds, Play, Forward 3 seconds, then the time. -->
                    <Grid Grid.Row="1" ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Width="32" Height="32" Padding="0" VerticalAlignment="Center" Style="{ThemeResource SubtleButtonStyle}" Click="BackClicked" AutomationProperties.Name="Back 3 seconds (J)" ToolTipService.ToolTip="Back 3 seconds (J)"><SymbolIcon Symbol="Previous"/></Button>
                        <Button x:Name="PreviewPlay" Grid.Column="1" Width="40" Height="40" Padding="0" CornerRadius="20" Click="PlayClicked" AutomationProperties.Name="Play" AutomationProperties.AcceleratorKey="Space" ToolTipService.ToolTip="Play (Space)"><SymbolIcon x:Name="PlayGlyph" Symbol="Play"/></Button>
                        <Button Grid.Column="2" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Style="{ThemeResource SubtleButtonStyle}" Click="ForwardClicked" AutomationProperties.Name="Forward 3 seconds" ToolTipService.ToolTip="Forward 3 seconds"><SymbolIcon Symbol="Next"/></Button>
                        <Border x:Name="AiModified" Grid.Column="3" CornerRadius="4" BorderBrush="{ThemeResource VcAccentTextBrush}" BorderThickness="1" Padding="4,1" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="AI modified" FontSize="12" Foreground="{ThemeResource VcAccentTextBrush}"/></Border>
                        <TextBlock x:Name="TransportTime" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource VcMonoFontFamily}" FontSize="13" Foreground="{ThemeResource VcTextPrimaryBrush}"><Run x:Name="TransportElapsed" Text="0:00.0"/><Run x:Name="TransportTotal" Foreground="{ThemeResource VcTextSecondaryBrush}"/></TextBlock>
                    </Grid>
                </Grid>
                <!-- Frame row (delta §5.1): 9:16 · 1:1 · 16:9 · Original, written to export.aspect. -->
                <Grid x:Name="FrameRow" Grid.Row="1" Height="32" Margin="16,8,16,12" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Frame" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource VcTextSecondaryBrush}"/>
                    <toolkit:Segmented x:Name="Aspect" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="AspectChanged" AutomationProperties.Name="Frame">
                        <toolkit:SegmentedItem Content="9:16"/>
                        <toolkit:SegmentedItem Content="1:1"/>
                        <toolkit:SegmentedItem Content="16:9"/>
                        <toolkit:SegmentedItem Content="Original"/>
                    </toolkit:Segmented>
                </Grid>
                <Grid x:Name="CaptionsHost" Grid.Row="2" BorderBrush="{ThemeResource VcLineDefaultBrush}" BorderThickness="0,1,0,0"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{ThemeResource VcLineDefaultBrush}" BorderThickness="0,1,0,0">
            <controls:TimelineView x:Name="Timeline"/>
        </Border>
    </Grid>
</Page>
