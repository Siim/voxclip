<Page x:Class="VoxClip.App.Pages.EditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:VoxClip.App.Controls" xmlns:local="using:VoxClip.App.Pages">
    <Grid x:Name="EditorRoot" KeyDown="EditorKeyDown" SizeChanged="EditorSizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Grid Padding="24,12,16,12" ColumnSpacing="16" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Make clips" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="ClipContext" Text="Select words in the transcript or find clips with AI." Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="MakeClipAction" Content="Make Clip from Selection" Click="MakeClipClicked" AutomationProperties.Name="Make clip from selected transcript words" ToolTipService.ToolTip="Make clip from selection (Ctrl+K)" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="FindClipsAction" Content="Find Clips" Click="FindClipsClicked" AutomationProperties.Name="Find clips with a chosen connector" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" Padding="0,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CommandBar x:Name="Commands" HorizontalAlignment="Left" DefaultLabelPosition="Right" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <AppBarButton Icon="Cut" Label="{x:Bind ViewModel.FillerLabel, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.Summary.CanCutFillers, Mode=OneWay}" Click="FillersClicked" ToolTipService.ToolTip="Cut fillers (Ctrl+Shift+U)"/>
                <AppBarButton Icon="Clock" Label="Tighten pauses" IsEnabled="{x:Bind ViewModel.Summary.CanTighten, Mode=OneWay}" Click="PausesClicked" ToolTipService.ToolTip="Tighten pauses (Ctrl+Shift+P)"/>
                <AppBarButton Icon="Undo" Label="Restore cuts" IsEnabled="{x:Bind ViewModel.Summary.HasEdits, Mode=OneWay}" Click="RestoreClicked" ToolTipService.ToolTip="Restore cuts (Ctrl+Shift+R)"/>
                <AppBarSeparator/>
                <AppBarToggleButton x:Name="PlayCommand" Icon="Play" Label="Play" Click="PlayClicked" ToolTipService.ToolTip="Play or pause (Space)"/>
                <AppBarButton x:Name="PanelsButton" Icon="OpenPane" Label="Clips and captions" Click="InspectorClicked" Visibility="Collapsed" ToolTipService.ToolTip="Show or hide Clips and Captions (Ctrl+Shift+I)"/>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Undo (Ctrl+Z)" Click="UndoClicked"/>
                    <AppBarButton Label="Redo (Ctrl+Y)" Click="RedoClicked"/>
                    <AppBarToggleButton x:Name="ShowCuts" Label="Show cut words" IsChecked="True" Click="DisplayChanged"/>
                    <AppBarToggleButton x:Name="ShowPauses" Label="Show pauses" IsChecked="True" Click="DisplayChanged"/>
                    <AppBarButton Label="Find (Ctrl+F)" Click="FindClicked"/>
                    <AppBarButton Label="Save project as…" Click="SaveAsClicked"/>
                    <AppBarButton Label="Show project file" Click="ShowProjectClicked"/>
                    <AppBarButton Label="Transcribe again…" Click="TranscribeAgainClicked"/>
                    <AppBarButton Label="Keyboard shortcuts (F1)" Click="ShortcutsClicked"/>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <Button Grid.Column="1" Content="Export…" Style="{StaticResource AccentButtonStyle}" Click="ExportClicked" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" VerticalAlignment="Center" ToolTipService.ToolTip="Export (Ctrl+E)"/>
        </Grid>
        <SplitView x:Name="InspectorSplit" Grid.Row="2" PanePlacement="Right" OpenPaneLength="320" DisplayMode="Inline" IsPaneOpen="True" Background="{ThemeResource VcBgWindowBrush}" PaneBackground="{ThemeResource VcBgSurfaceBrush}">
            <SplitView.Pane><Grid x:Name="InspectorHost"/></SplitView.Pane>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
                <Grid x:Name="ContentPanes">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="4"/><ColumnDefinition x:Name="PreviewColumn" Width="380"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                    <Grid x:Name="TranscriptPane" Background="{ThemeResource VcBgSurfaceBrush}" CornerRadius="8,0,0,0" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <InfoBar x:Name="EditorNotice" IsOpen="{x:Bind local:EditorPage.HasText(ViewModel.Notice), Mode=OneWay}" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Severity="Informational"/>
                        <Grid Grid.Row="1" Padding="24,12,24,0">
                            <TextBlock Text="TRANSCRIPT · EDIT BY WORDS" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Find" Click="FindClicked" HorizontalAlignment="Right" Style="{ThemeResource SubtleButtonStyle}"/>
                        </Grid>
                        <StackPanel x:Name="FindBar" Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="24,0" Visibility="Collapsed">
                            <TextBox x:Name="SearchText" Header="Find words" Width="160" TextChanged="SearchChanged"/>
                            <Button x:Name="CutMatches" Content="Cut all matches" VerticalAlignment="Bottom" Click="CutMatchesClicked"/>
                            <Button Content="Close" VerticalAlignment="Bottom" Click="CloseFindClicked"/>
                        </StackPanel>
                        <controls:TranscriptView x:Name="Transcript" Grid.Row="3"/>
                        <StackPanel x:Name="Untranscribed" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380" Spacing="12" Padding="24">
                            <TextBlock Text="This video isn't transcribed yet." TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="Choose on this PC or ElevenLabs to turn the video into words. Then select words to make a clip, or use Find Clips." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Button Content="Choose Transcription…" Click="TranscribeClicked" AutomationProperties.Name="Choose local or cloud transcription" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                    <Thumb x:Name="PaneSplitter" Grid.Column="1" DragDelta="SplitterDragged" AutomationProperties.Name="Resize transcript and preview" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Grid x:Name="PreviewPane" Grid.Column="2" Padding="16,16,16,24" RowSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="PreviewStage" Background="{ThemeResource VcStageBrush}" RequestedTheme="Dark" CornerRadius="12" MinHeight="180">
                            <Grid>
                                <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="Video preview"/>
                                <TextBlock x:Name="PreviewEmpty" Text="Preview unavailable. Your video and edits are still here." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="20" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource VcOverlayTransportOpaqueBrush}" BorderBrush="{ThemeResource VcLineStrongBrush}" BorderThickness="1" CornerRadius="18" Padding="8,0" Height="40" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8,8,8,16">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button x:Name="PreviewPlay" Click="PlayClicked" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="Play or pause (Space)" Padding="6"><SymbolIcon Symbol="Play"/></Button>
                                        <TextBlock x:Name="TransportTime" Text="0:00.0" FontFamily="{StaticResource VcMonoFontFamily}" FontSize="{StaticResource VcTimecodeFontSize}" VerticalAlignment="Center" Foreground="{ThemeResource VcTextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <RadioButtons x:Name="Aspect" Grid.Row="1" Header="Preview aspect" MaxColumns="4" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="AspectChanged"><x:String>Source</x:String><x:String>16:9</x:String><x:String>9:16</x:String><x:String>1:1</x:String></RadioButtons>
                        <TextBlock x:Name="PreviewDescription" Grid.Row="2" Text="Your source video is never changed." Style="{StaticResource HelperText}"/>
                    </Grid>
                </Grid>
                <controls:TimelineView x:Name="Timeline" Grid.Row="1"/>
            </Grid>
        </SplitView>
        <Grid Grid.Row="3" Padding="24,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="FooterExport" Grid.Column="1" Content="Export…" Click="ExportClicked" Padding="8,2" MinHeight="28" IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Page>
