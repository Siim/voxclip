<Page x:Class="VoxClip.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="using:VoxClip.App.ViewModels">
    <Grid Padding="48,32" MaxWidth="1040" HorizontalAlignment="Stretch" RowSpacing="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock x:Uid="HomeHeadline" Text="Cut video by its words." Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock x:Uid="HomeDescription" Text="Drop a talking-head video. VoxClip transcribes it so you can cut text." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" MinHeight="220">
            <Rectangle Stroke="{ThemeResource VcOverlayDropZoneBorderBrush}" StrokeThickness="2" StrokeDashArray="6,4" RadiusX="16" RadiusY="16" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <SymbolIcon Symbol="OpenFile" HorizontalAlignment="Center" />
                <TextBlock Text="Drop a video here" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text=".mov   .mp4   .m4v   .mkv   .webm" Style="{StaticResource HelperText}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Choose file…" Click="ImportClicked" AutomationProperties.Name="Import video, Ctrl+O" ToolTipService.ToolTip="Choose file… (Ctrl+O)" />
                    <Button Content="Open project…" Click="OpenClicked" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="Recent" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <Grid Grid.Row="3">
            <TextBlock x:Name="EmptyRecent" Text="{x:Bind ViewModel.EmptyMessage}" Style="{StaticResource HelperText}" />
            <ListView x:Name="RecentList" ItemsSource="{x:Bind ViewModel.RecentProjects}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentClicked" AutomationProperties.Name="Recent projects">
                <ListView.ItemTemplate><DataTemplate x:DataType="models:RecentProject">
                    <Grid Padding="0,8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4" Height="40" Width="56">
                            <Grid><SymbolIcon Symbol="Video"/><Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/></Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel>
                        <Grid.ContextFlyout><MenuFlyout>
                            <MenuFlyoutItem Text="Show in Explorer" Tag="{x:Bind Path}" Click="ShowRecentInExplorer" />
                            <MenuFlyoutItem Text="Remove from list" Tag="{x:Bind Path}" Click="RemoveRecent" />
                        </MenuFlyout></Grid.ContextFlyout>
                    </Grid>
                </DataTemplate></ListView.ItemTemplate>
            </ListView>
        </Grid>
        <InfoBar x:Name="RecentNotice" Grid.Row="4" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" Severity="Informational">
            <InfoBar.ActionButton><Button Content="Settings" Click="SettingsClicked" /></InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Page>
