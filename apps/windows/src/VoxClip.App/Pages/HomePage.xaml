<Page x:Class="VoxClip.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VoxClip.App.ViewModels"
    xmlns:controls="using:VoxClip.App.Controls">
    <!-- Home, design §7 (ADR-R29): the drop bar or first-run hero, the AI callout, then Recent projects. One
         GridView scrolls the page; its header holds everything above the cards, so card containers stay virtualized. -->
    <GridView x:Name="RecentGrid" ItemsSource="{x:Bind ViewModel.Shown}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentClicked"
        Padding="32,32,16,32" SizeChanged="GridSizeChanged" AutomationProperties.Name="Recent projects" TabNavigation="Once">
        <GridView.Header>
            <StackPanel Margin="0,0,16,16" Spacing="16">
                <!-- First run: a 232-high hero instead of the drop bar, with no Recent header. -->
                <Grid x:Name="Hero" Height="232" Visibility="{x:Bind ViewModel.IsFirstRun, Mode=OneWay}">
                    <Rectangle Fill="{ThemeResource VcBgSunkenBrush}" Stroke="{ThemeResource VcLineStrongBrush}" StrokeThickness="1.5" StrokeDashArray="4,2.7" RadiusX="10" RadiusY="10"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Drop a talking-head video" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="VoxClip transcribes it so you can cut by words, make clips and add captions." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="Import video…" Style="{StaticResource AccentButtonStyle}" Height="40" Click="ImportClicked" AutomationProperties.Name="Import video, Ctrl+O" ToolTipService.ToolTip="Import video (Ctrl+O)"/>
                            <Button Content="Open project…" Height="40" Click="OpenClicked"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="MP4, MOV, M4V, MKV, WEBM · Media and edits stay on this PC." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- Drop bar, once any project exists: 64 high on bg.sunken with a 1.5 dashed line.strong border. -->
                <Grid x:Name="DropBar" Height="64" Visibility="{x:Bind ViewModel.HasProjects, Mode=OneWay}">
                    <Rectangle Fill="{ThemeResource VcBgSunkenBrush}" Stroke="{ThemeResource VcLineStrongBrush}" StrokeThickness="1.5" StrokeDashArray="4,2.7" RadiusX="10" RadiusY="10"/>
                    <Grid Padding="18,0,12,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Drop a talking-head video, or" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Import video…" Style="{StaticResource AccentButtonStyle}" Height="40" VerticalAlignment="Center" Click="ImportClicked"
                            AutomationProperties.Name="Import video, Ctrl+O" ToolTipService.ToolTip="Import video (Ctrl+O)"/>
                        <Button Grid.Column="3" Content="Open project…" Height="40" VerticalAlignment="Center" Click="OpenClicked"/>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="MP4, MOV, M4V, MKV, WEBM · stays on this PC" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <!-- Startup problems (shared resources or settings) keep their own warning above the AI callout. -->
                <InfoBar x:Name="StartupBar" IsOpen="False" Severity="Warning"/>
                <InfoBar x:Name="AiBar" IsOpen="False" IsClosable="False" Severity="Informational">
                    <InfoBar.ActionButton><Button x:Name="AiAction" Click="AiActionClicked"/></InfoBar.ActionButton>
                </InfoBar>
                <Grid Height="32" ColumnSpacing="8" Margin="0,8,0,0" Visibility="{x:Bind ViewModel.HasProjects, Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Recent projects" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
                    <AutoSuggestBox x:Name="Search" Grid.Column="1" Width="260" PlaceholderText="Search projects" QueryIcon="Find" TextChanged="SearchChanged"
                        AutomationProperties.Name="Search projects"/>
                    <DropDownButton Grid.Column="2" Content="{x:Bind ViewModel.SortLabel, Mode=OneWay}" AutomationProperties.Name="Sort projects">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <RadioMenuFlyoutItem Text="Last opened" GroupName="Sort" IsChecked="True" Click="SortLastOpened"/>
                                <RadioMenuFlyoutItem Text="Name" GroupName="Sort" Click="SortName"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.NoMatch, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNoMatch, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </GridView.Header>
        <GridView.ItemsPanel>
            <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="242" ItemHeight="207"/></ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
            <Style TargetType="GridViewItem">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
            <DataTemplate x:DataType="models:RecentProject">
                <Grid Margin="0,0,16,16" Background="Transparent" AutomationProperties.HelpText="{x:Bind Description, Mode=OneWay}">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                    <!-- The media tile, design §5.4: frame, else caption card, else stage black, with its chip and progress line. -->
                    <controls:MediaThumbnail CornerRadius="10" Surface="Home" Media="{x:Bind Media, Mode=OneWay}"/>
                    <StackPanel Grid.Row="1" Padding="0,8,0,0">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <!-- Cancel and Locate… sit on the meta line, 32 high (design §7). -->
                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ShowsMeta, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Meta, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="Cancel" Height="32" Padding="6,0" Tag="{x:Bind Path}" Click="CancelTranscriptionClicked"
                                Visibility="{x:Bind ShowsCancel, Mode=OneWay}" AutomationProperties.Name="{x:Bind CancelName, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ShowsWarning, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Warning, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource VcStatusWarningBrush}" VerticalAlignment="Center"/>
                            <HyperlinkButton Content="Locate…" Height="32" Padding="6,0" Tag="{x:Bind Path}" Click="LocateClicked" AutomationProperties.Name="{x:Bind LocateName, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Open" Tag="{x:Bind Path}" Click="OpenRecent"/>
                            <MenuFlyoutItem Text="Show in Explorer" Tag="{x:Bind Path}" Click="ShowRecentInExplorer"/>
                            <MenuFlyoutItem Text="Remove from list" Tag="{x:Bind Path}" Click="RemoveRecent"/>
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </DataTemplate>
        </GridView.ItemTemplate>
    </GridView>
</Page>
