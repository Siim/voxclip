<Page x:Class="VoxClip.App.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="24" Padding="40" MaxWidth="960" HorizontalAlignment="Stretch">
            <TextBlock Text="VoxClip" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Cut video by editing words." Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.EmptyMessage}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Import video…" Click="ImportClicked" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Import video" />
                <Button Content="Open project…" Click="OpenClicked" AutomationProperties.Name="Open project" />
                <Button Content="Settings" Click="SettingsClicked" />
            </StackPanel>
            <TextBlock Text="Recent projects" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.RecentProjects}" MinHeight="120" AutomationProperties.Name="Recent projects" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Windows skeleton"
                Message="The editor layout is ready for implementation. Import, transcription and export are not connected yet." />
        </StackPanel>
    </ScrollViewer>
</Page>
