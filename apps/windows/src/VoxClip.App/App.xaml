<Application x:Class="VoxClip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Themes/Workspace.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Ink accent ramp (doc/design.md section 14): light fills use Dark1 (accent.default, the icon tile's ink) and
                 Dark2 (accent.pressed); dark fills use Light2 (accent.text, paper) with ink TextOnAccent. SystemAccentColor
                 is #6D6F73, a cool graphite, in both themes, so text selection and SystemControlHighlightAccentBrush never
                 fall back to the user's accent. High Contrast keeps the system colours.
                 WinUI 2.3.9 builds TextOnAccentFillColorPrimaryBrush from its own colour with StaticResource, so
                 framework controls may keep #FFFFFF / #000000 on the accent; both still pass 4.5:1.
                 tools/design/contrast.test.mjs pins this ramp and checks every text and fill WinUI draws from it. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="SystemAccentColor">#6D6F73</Color>
                    <Color x:Key="SystemAccentColorDark1">#2C2E35</Color>
                    <Color x:Key="SystemAccentColorDark2">#1A1B1F</Color>
                    <Color x:Key="SystemAccentColorDark3">#0F1013</Color>
                    <Color x:Key="TextOnAccentFillColorPrimary">#FAF9F6</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <Color x:Key="SystemAccentColor">#6D6F73</Color>
                    <Color x:Key="SystemAccentColorLight1">#D2D1CC</Color>
                    <Color x:Key="SystemAccentColorLight2">#ECEAE4</Color>
                    <Color x:Key="SystemAccentColorLight3">#FAF9F6</Color>
                    <Color x:Key="TextOnAccentFillColorPrimary">#141517</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextDecorations="Underline" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="primitives:CommandBarFlyoutCommandBar" BasedOn="{StaticResource DefaultCommandBarFlyoutCommandBarStyle}">
                <Setter Property="DefaultLabelPosition" Value="Right"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Background" Value="{ThemeResource VcBgElevatedBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource VcTextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource VcLineStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="HelperText" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
