<Window x:Class="VoxClip.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VoxClip.App.Controls"
    xmlns:vm="using:VoxClip.App.ViewModels">
    <Grid x:Name="Root" AllowDrop="True" DragEnter="FileDragOver" DragOver="FileDragOver" DragLeave="FileDragLeave" Drop="FileDropped">
        <Grid.Resources>
            <!-- The default NavigationViewItemHeader shows Content only as text, and its theme style, which still applies under
                 this one, disables it and hides it from Narrator. This keeps its pane states, hosts content and keeps the
                 content's buttons enabled and named (design §3.4, §13). -->
            <Style x:Key="SidebarHeaderStyle" TargetType="NavigationViewItemHeader">
                <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemHeaderForeground}" />
                <Setter Property="IsEnabled" Value="True" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Content" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="NavigationViewItemHeader">
                            <Grid x:Name="NavigationViewItemHeaderRootGrid">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="PaneStates">
                                        <VisualState x:Name="HeaderTextVisible" />
                                        <VisualState x:Name="HeaderTextCollapsed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderContent.Visibility" Value="Collapsed" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="HeaderContent" Margin="{ThemeResource NavigationViewItemInnerHeaderMargin}" MinHeight="40"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Sidebar rows, design §3.4. Clip rows carry their number on the thumbnail badge. Thumbnails are media tiles: a
                 frame, else the downscaled caption card with no plates, else stage black (design §5.4). -->
            <DataTemplate x:Key="HomeRow" x:DataType="vm:SidebarRow">
                <NavigationViewItem Content="{x:Bind Title, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ToolTipService.ToolTip="Home (Ctrl+1)">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="SeparatorRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemSeparator/>
            </DataTemplate>
            <DataTemplate x:Key="ProjectRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Style="{StaticResource SidebarHeaderStyle}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <StackPanel Padding="0,10,0,6">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </NavigationViewItemHeader>
            </DataTemplate>
            <DataTemplate x:Key="FullTakeRow" x:DataType="vm:SidebarRow">
                <NavigationViewItem MinHeight="{x:Bind RowHeight, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ToolTipService.ToolTip="Full take (Ctrl+2)">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <controls:MediaThumbnail Width="{StaticResource VcLayoutRowThumbColumnWidth}" Height="{StaticResource VcLayoutTakeThumbHeight}" CornerRadius="3" Surface="Sidebar" Media="{x:Bind Media, Mode=OneWay}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <!-- Meta (design §3.4): only the duration is Cascadia Mono; the status is UI text. -->
                            <StackPanel Orientation="Horizontal" Spacing="4"><ProgressRing Width="12" Height="12" Foreground="{ThemeResource VcAccentTextBrush}" IsActive="{x:Bind IsExporting, Mode=OneWay}" Visibility="{x:Bind IsExporting, Mode=OneWay}" AutomationProperties.Name="Exporting"/><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VcTextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{x:Bind MetaTime, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}"/><Run Text="{x:Bind MetaStatus, Mode=OneWay}"/></TextBlock></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasExportDetail, Mode=OneWay}"><TextBlock Text="{x:Bind ExportDetail, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource VcStatusWarningBrush}"/><HyperlinkButton Content="Retry" Tag="{x:Bind ClipId}" FontSize="11" Padding="0" Click="RetryExportClicked" Tapped="RowButtonTapped" Visibility="{x:Bind ShowsRetry, Mode=OneWay}"/></StackPanel>
                        </StackPanel>
                        <HyperlinkButton Grid.Column="2" Content="Cancel" Height="32" Padding="6,0" VerticalAlignment="Center" Click="CancelTakeTranscriptionClicked" Tapped="RowButtonTapped"
                            Visibility="{x:Bind ShowsCancel, Mode=OneWay}" AutomationProperties.Name="{x:Bind CancelName, Mode=OneWay}"/>
                    </Grid>
                </NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="ClipRow" x:DataType="vm:SidebarRow">
                <NavigationViewItem MinHeight="{x:Bind RowHeight, Mode=OneWay}" Tag="{x:Bind ClipId}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                    KeyboardAcceleratorPlacementMode="Hidden" Loaded="ScopeRowKeys">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F2" Invoked="RenameClipInvoked"/>
                        <KeyboardAccelerator Key="Delete" Invoked="RemoveClipInvoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                    <NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <!-- On Home the project's rows only navigate: the commands that act on the hidden editor are disabled. -->
                            <MenuFlyoutItem Text="Export clip…" Tag="{x:Bind ClipId}" Click="ExportClipClicked" IsEnabled="{x:Bind Edits, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="Rename…" KeyboardAcceleratorTextOverride="F2" Tag="{x:Bind ClipId}" Click="RenameClipClicked" IsEnabled="{x:Bind Edits, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="Copy text" Tag="{x:Bind ClipId}" Click="CopyClipTextClicked"/>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Remove clip" KeyboardAcceleratorTextOverride="Delete" Tag="{x:Bind ClipId}" Click="RemoveClipClicked" IsEnabled="{x:Bind Edits, Mode=OneWay}"/>
                        </MenuFlyout>
                    </NavigationViewItem.ContextFlyout>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <!-- A 27x48 media tile in a 32 column; the 16 badge sits over its top-left corner at -4 with a 1 px page ring. -->
                        <Grid Width="{StaticResource VcLayoutRowThumbColumnWidth}" Height="{StaticResource VcLayoutClipThumbHeight}">
                            <controls:MediaThumbnail Width="{StaticResource VcLayoutClipThumbWidth}" Height="{StaticResource VcLayoutClipThumbHeight}" HorizontalAlignment="Right" CornerRadius="4" Surface="ClipRow" Media="{x:Bind Media, Mode=OneWay}"/>
                            <Border Width="16" Height="16" Margin="1,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource VcBgSurfaceBrush}" Background="{ThemeResource VcClipBadgeBackgroundBrush}" Visibility="{x:Bind IsNeutral, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Number, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}" FontSize="{StaticResource VcLayoutBadgeFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource VcTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="16" Height="16" Margin="1,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource VcBgSurfaceBrush}" Background="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsActive, Mode=OneWay}">
                                <TextBlock Text="{x:Bind Number, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}" FontSize="{StaticResource VcLayoutBadgeFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="4"><ProgressRing Width="12" Height="12" Foreground="{ThemeResource VcAccentTextBrush}" IsActive="{x:Bind IsExporting, Mode=OneWay}" Visibility="{x:Bind IsExporting, Mode=OneWay}" AutomationProperties.Name="Exporting"/><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VcTextSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{x:Bind MetaTime, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}"/><Run Text="{x:Bind MetaStatus, Mode=OneWay}"/></TextBlock></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind HasExportDetail, Mode=OneWay}"><TextBlock Text="{x:Bind ExportDetail, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource VcStatusWarningBrush}"/><HyperlinkButton Content="Retry" Tag="{x:Bind ClipId}" FontSize="11" Padding="0" Click="RetryExportClicked" Tapped="RowButtonTapped" Visibility="{x:Bind ShowsRetry, Mode=OneWay}"/></StackPanel>
                        </StackPanel>
                    </Grid>
                </NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="SuggestedHeaderRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Style="{StaticResource SidebarHeaderStyle}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" VerticalAlignment="Center"/>
                        <HyperlinkButton Grid.Column="1" Content="Keep all" Height="32" Padding="6,0" Click="KeepAllClicked" Visibility="{x:Bind ShowsKeepAll, Mode=OneWay}" IsEnabled="{x:Bind Edits, Mode=OneWay}" AutomationProperties.Name="Keep all suggested clips"/>
                    </Grid>
                </NavigationViewItemHeader>
            </DataTemplate>
            <DataTemplate x:Key="SuggestionRow" x:DataType="vm:SidebarRow">
                <NavigationViewItem MinHeight="{StaticResource VcLayoutClipRowHeight}" Tag="{x:Bind ClipId}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind ToolTip, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                    KeyboardAcceleratorPlacementMode="Hidden" Loaded="ScopeRowKeys">
                    <NavigationViewItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="KeepSuggestionInvoked"/>
                        <KeyboardAccelerator Key="Delete" Invoked="DismissSuggestionInvoked"/>
                    </NavigationViewItem.KeyboardAccelerators>
                    <NavigationViewItem.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Keep clip" KeyboardAcceleratorTextOverride="Ctrl+Enter" Tag="{x:Bind ClipId}" Click="KeepClicked" IsEnabled="{x:Bind Edits, Mode=OneWay}"/>
                            <MenuFlyoutItem Text="Dismiss" KeyboardAcceleratorTextOverride="Delete" Tag="{x:Bind ClipId}" Click="DismissClicked" IsEnabled="{x:Bind Edits, Mode=OneWay}"/>
                        </MenuFlyout>
                    </NavigationViewItem.ContextFlyout>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="{StaticResource VcLayoutRowThumbColumnWidth}" Height="{StaticResource VcLayoutClipThumbHeight}">
                            <controls:MediaThumbnail Width="{StaticResource VcLayoutClipThumbWidth}" Height="{StaticResource VcLayoutClipThumbHeight}" HorizontalAlignment="Right" CornerRadius="4" Surface="ClipRow" Media="{x:Bind Media, Mode=OneWay}"/>
                            <Border Width="16" Height="16" Margin="1,-4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource VcBgSurfaceBrush}">
                                <Grid>
                                    <Rectangle Fill="{ThemeResource VcBgSurfaceBrush}" Stroke="{ThemeResource VcLineStrongBrush}" StrokeThickness="1" StrokeDashArray="2,2" RadiusX="4" RadiusY="4"/>
                                    <TextBlock Text="{x:Bind Number, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}" FontSize="{StaticResource VcLayoutBadgeFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource VcTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{x:Bind MetaTime, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}"/><Run Text="{x:Bind MetaStatus, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                        <!-- Keep and Dismiss: 32x32 subtle icon buttons that never select the row. -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" Tag="{x:Bind ClipId}" Click="KeepClicked" Tapped="RowButtonTapped" IsEnabled="{x:Bind Edits, Mode=OneWay}"
                                ToolTipService.ToolTip="Keep (Ctrl+Enter)" AutomationProperties.Name="{x:Bind KeepName, Mode=OneWay}"><FontIcon Glyph="&#xE73E;" FontSize="14"/></Button>
                            <Button Width="32" Height="32" Padding="0" Style="{ThemeResource SubtleButtonStyle}" Tag="{x:Bind ClipId}" Click="DismissClicked" Tapped="RowButtonTapped" IsEnabled="{x:Bind Edits, Mode=OneWay}"
                                ToolTipService.ToolTip="Dismiss (Delete)" AutomationProperties.Name="{x:Bind DismissName, Mode=OneWay}"><FontIcon Glyph="&#xE711;" FontSize="14"/></Button>
                        </StackPanel>
                    </Grid>
                </NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="EmptyRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Style="{StaticResource SidebarHeaderStyle}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </NavigationViewItemHeader>
            </DataTemplate>
            <!-- While Find clips runs: under Suggested, a fixed-width ring, Cancel and the connector line (design §6.2). -->
            <DataTemplate x:Key="FindingRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Style="{StaticResource SidebarHeaderStyle}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressRing Width="16" Height="16" IsActive="True" VerticalAlignment="Center" AutomationProperties.Name="Finding clips"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="Normal"/>
                            <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <HyperlinkButton Grid.Column="2" Content="Cancel" Height="32" Padding="6,0" Click="CancelFindingClicked" AutomationProperties.Name="Cancel finding clips"/>
                    </Grid>
                </NavigationViewItemHeader>
            </DataTemplate>
            <!-- The last Find clips run found nothing: the prompt file's message with Find clips…, under Suggested (design §13). -->
            <DataTemplate x:Key="NoneFoundRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Style="{StaticResource SidebarHeaderStyle}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <StackPanel Padding="0,4">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <HyperlinkButton Content="Find clips…" Height="32" Padding="6,0" Margin="-6,0,0,0" Click="FindClipsAgainClicked" IsEnabled="{x:Bind Edits, Mode=OneWay}"/>
                    </StackPanel>
                </NavigationViewItemHeader>
            </DataTemplate>
            <!-- No connector, or a problem finding clips: a callout under the actions with its one action (design §13). -->
            <DataTemplate x:Key="CalloutRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Style="{StaticResource SidebarHeaderStyle}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                    <InfoBar IsOpen="True" Severity="Informational" Title="{x:Bind Title, Mode=OneWay}" Message="{x:Bind Detail, Mode=OneWay}" CloseButtonClick="CalloutClosed">
                        <InfoBar.ActionButton><Button Content="{x:Bind Action, Mode=OneWay}" Click="CalloutActionClicked" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" Visibility="{x:Bind HasAction, Mode=OneWay}"/></InfoBar.ActionButton>
                    </InfoBar>
                </NavigationViewItemHeader>
            </DataTemplate>
            <!-- A disabled item shows no tooltip, so the reason is also its help text (design §7.1). -->
            <DataTemplate x:Key="ActionRow" x:DataType="vm:SidebarRow">
                <NavigationViewItem SelectsOnInvoked="False" IsEnabled="{x:Bind IsEnabled, Mode=OneWay}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}" AutomationProperties.AcceleratorKey="{x:Bind Detail, Mode=OneWay}"
                    AutomationProperties.HelpText="{x:Bind ToolTip, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressRing Width="16" Height="16" Margin="0,0,8,0" Foreground="{ThemeResource VcAccentTextBrush}" IsActive="{x:Bind IsLlmBusy, Mode=OneWay}" Visibility="{x:Bind IsLlmBusy, Mode=OneWay}" AutomationProperties.Name="Finish the current task first."/>
                        <TextBlock Grid.Column="1" Margin="0,0,8,0" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                    <NavigationViewItem.Icon><FontIcon Glyph="{x:Bind controls:SidebarItems.ActionGlyph(Key)}"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </DataTemplate>
            <DataTemplate x:Key="RecentHeaderRow" x:DataType="vm:SidebarRow">
                <NavigationViewItemHeader Content="{x:Bind Title}" AutomationProperties.Name="{x:Bind AccessibleName}"/>
            </DataTemplate>
            <DataTemplate x:Key="RecentRow" x:DataType="vm:SidebarRow">
                <NavigationViewItem SelectsOnInvoked="False" MinHeight="{StaticResource VcLayoutNavRowHeight}" AutomationProperties.Name="{x:Bind Recent.AccessibleName, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Recent.Path}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <controls:MediaThumbnail Width="{StaticResource VcLayoutRowThumbColumnWidth}" Height="{StaticResource VcLayoutTakeThumbHeight}" CornerRadius="3" Surface="Sidebar" Media="{x:Bind Recent.Media, Mode=OneWay}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Recent.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                Visibility="{x:Bind Recent.DetailIsPlain, Mode=OneWay}"><Run Text="{x:Bind Recent.DetailTime, Mode=OneWay}" FontFamily="{StaticResource VcMonoFontFamily}"/><Run Text="{x:Bind Recent.DetailStatus, Mode=OneWay}"/></TextBlock>
                            <TextBlock Text="{x:Bind Recent.Detail, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource VcStatusWarningBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                Visibility="{x:Bind Recent.DetailIsWarning, Mode=OneWay}"/>
                        </StackPanel>
                        <HyperlinkButton Grid.Column="2" Content="Cancel" Height="32" Padding="6,0" VerticalAlignment="Center" Tag="{x:Bind Recent.Path}" Click="CancelRecentTranscriptionClicked" Tapped="RowButtonTapped"
                            Visibility="{x:Bind Recent.ShowsCancel, Mode=OneWay}" AutomationProperties.Name="{x:Bind Recent.CancelName, Mode=OneWay}"/>
                    </Grid>
                </NavigationViewItem>
            </DataTemplate>
            <controls:SidebarItems x:Key="SidebarTemplates" Home="{StaticResource HomeRow}" Separator="{StaticResource SeparatorRow}" Project="{StaticResource ProjectRow}"
                FullTake="{StaticResource FullTakeRow}" Clip="{StaticResource ClipRow}" SuggestedHeader="{StaticResource SuggestedHeaderRow}" Suggestion="{StaticResource SuggestionRow}"
                Action="{StaticResource ActionRow}" RecentHeader="{StaticResource RecentHeaderRow}" Recent="{StaticResource RecentRow}"
                Empty="{StaticResource EmptyRow}" Finding="{StaticResource FindingRow}" Callout="{StaticResource CalloutRow}" NoneFound="{StaticResource NoneFoundRow}"/>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="VoxClip" IsBackButtonVisible="False" IsPaneToggleButtonVisible="True" PaneToggleRequested="PaneToggleRequested">
            <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/VoxClip.ico"/></TitleBar.IconSource>
            <TitleBar.RightHeader><Button Click="SettingsClicked" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="Settings (Ctrl+,)" ToolTipService.ToolTip="Settings (Ctrl+,)"><SymbolIcon Symbol="Setting" /></Button></TitleBar.RightHeader>
        </TitleBar>
        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="{StaticResource VcSizeSidebar}" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False" MenuItemsSource="{x:Bind Shell.Rows}" MenuItemTemplateSelector="{StaticResource SidebarTemplates}"
            SelectionChanged="NavSelectionChanged" ItemInvoked="NavItemInvoked" AutomationProperties.Name="Library and clips">
            <NavigationView.Resources>
                <!-- The content layer below draws the page, its corner and its stroke (design §3.3). -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
            </NavigationView.Resources>
            <Grid x:Name="ContentLayer" Background="{ThemeResource VcBgSurfaceBrush}" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <InfoBar x:Name="WindowNotice" IsOpen="False" />
                <Frame x:Name="ContentFrame" Grid.Row="1" />
                <Grid x:Name="DropOverlay" Grid.RowSpan="2" Margin="12" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border Background="{ThemeResource VcOverlayDropBrush}" CornerRadius="14"/>
                    <Rectangle Stroke="{ThemeResource VcOverlayDropBorderBrush}" StrokeThickness="2" StrokeDashArray="3,2" RadiusX="14" RadiusY="14"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="32" Foreground="{ThemeResource VcTextPrimaryBrush}"/>
                        <TextBlock Text="Drop to transcribe" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
        <!-- Points at the Find clips callout when Find clips was asked for away from the pane (design §13). -->
        <TeachingTip x:Name="CalloutTip" Grid.Row="1" PreferredPlacement="Right" IsLightDismissEnabled="True" ActionButtonClick="CalloutTipActionClicked"/>
    </Grid>
</Window>
