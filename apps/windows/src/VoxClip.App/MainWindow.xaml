<Window x:Class="VoxClip.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" AllowDrop="True" DragOver="FileDragOver" Drop="FileDropped">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="VoxClip" BackRequested="BackRequested">
            <TitleBar.RightHeader><Button Click="SettingsClicked" Style="{ThemeResource SubtleButtonStyle}" AutomationProperties.Name="Settings (Ctrl+,)" ToolTipService.ToolTip="Settings (Ctrl+,)"><SymbolIcon Symbol="Setting" /></Button></TitleBar.RightHeader>
        </TitleBar>
        <InfoBar x:Name="WindowNotice" Grid.Row="1" IsOpen="False" />
        <Frame x:Name="ContentFrame" Grid.Row="2" />
    </Grid>
</Window>
