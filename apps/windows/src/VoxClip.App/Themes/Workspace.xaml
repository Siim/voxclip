<!-- Hand-written sizes for the ADR-R29 clips-first workspace (doc/design.md sections 3-7 and C16).
     Colours stay in the generated Tokens.xaml and the Fluent theme resources; this file holds no colour. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Timecodes, durations and badges: Cascadia Mono, falling back to Consolas (C1). -->
    <FontFamily x:Key="VcMonoFontFamily">Cascadia Mono, Consolas</FontFamily>
    <!-- Transcript page: Segoe UI Variable Text 19/32; zoom keeps the 32/19 ratio (C4). -->
    <x:Double x:Key="VcLayoutTranscriptFontSize">19</x:Double>
    <x:Double x:Key="VcLayoutTranscriptLineHeight">32</x:Double>
    <x:Double x:Key="VcLayoutTimecodeFontSize">12</x:Double>
    <x:Double x:Key="VcLayoutPauseTokenFontSize">12</x:Double>
    <x:Double x:Key="VcLayoutBadgeFontSize">11</x:Double>
    <!-- Window shell: NavigationView pane, design §3.1 and §3.3. -->
    <x:Double x:Key="VcLayoutPaneLength">264</x:Double>
    <x:Double x:Key="VcLayoutPaneBreakpoint">960</x:Double>
    <!-- Sidebar rows, design §3.4: Full take and Recent 44 high with a 32x18 thumbnail; clips 60 high with a 27x48 thumbnail in a 32 column and a 16 badge. -->
    <x:Double x:Key="VcLayoutFullTakeRowHeight">44</x:Double>
    <x:Double x:Key="VcLayoutClipRowHeight">60</x:Double>
    <x:Double x:Key="VcLayoutRowThumbColumnWidth">32</x:Double>
    <x:Double x:Key="VcLayoutTakeThumbHeight">18</x:Double>
    <x:Double x:Key="VcLayoutClipThumbWidth">27</x:Double>
    <x:Double x:Key="VcLayoutClipThumbHeight">48</x:Double>
    <x:Double x:Key="VcLayoutBadgeSize">16</x:Double>
</ResourceDictionary>
