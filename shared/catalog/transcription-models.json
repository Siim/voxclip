{
  "schema": "voxclip.transcription-catalog",
  "schemaVersion": 1,
  "catalogVersion": "2026-10-25",
  "spec": "doc/spec/transcription.md#12-model-catalogue-and-model-manager",
  "storage": "<data>/Models/<engine>/<modelId>/<file name> (doc/architecture.md section 2.5)",
  "notes": [
    "Bundled into both apps as a resource and treated as trusted. v1 never fetches a remote catalogue.",
    "Every file URL is a Hugging Face resolve URL pinned to a commit revision, so the bytes behind a URL cannot change. sha256 and bytes come from the Hugging Face LFS metadata (api/models/<repo>/tree) and were cross-checked against the X-Linked-Size and X-Linked-Etag headers of the resolve URL on 2026-10-25.",
    "Resolve URLs answer 302 to a CDN host (cdn.hf.co). Clients follow the redirect; the confirmation sheet names the catalogue host (huggingface.co).",
    "VoxClip hosts no model files. Every model is a third-party download that the user confirms once.",
    "Languages are BCP-47 primary language subtags (ISO 639-1 where one exists). '*' means any language the engine accepts, including auto-detection."
  ],
  "engines": [
    {
      "id": "elevenlabs",
      "displayName": "ElevenLabs Scribe",
      "kind": "cloud",
      "platforms": ["macos", "windows"],
      "endpoint": "https://api.elevenlabs.io/v1/speech-to-text",
      "modelId": "scribe_v2",
      "languages": ["*"],
      "autoLanguage": true,
      "verbatim": true,
      "timing": "native",
      "requiresKey": "elevenlabs",
      "keyPermissions": ["speech_to_text"],
      "privacy": "thirdPartyCloud",
      "sends": "The audio track only, as a 16 kHz mono 16-bit WAV. No video, title or project data.",
      "limits": {
        "minDurationSeconds": 0.1,
        "maxDurationSeconds": 36000,
        "maxUploadBytes": 3000000000,
        "limitsNote": "The API reference says files must be under 5.0 GB; the capability page says up to 3 GB and 10 hours. VoxClip enforces the stricter pair."
      },
      "pricing": {
        "currency": "USD",
        "perAudioHour": 0.22,
        "keytermsSurchargeFraction": 0.20,
        "keytermsMinimumBilledSecondsOver100Terms": 20,
        "silenceIsBilled": true,
        "asOf": "2026-10-25",
        "source": "https://elevenlabs.io/pricing/api"
      },
      "languageQuality": {
        "et": "Excellent tier (WER <= 5%) per https://elevenlabs.io/docs/overview/capabilities/speech-to-text",
        "en": "Excellent tier (WER <= 5%)"
      }
    },
    {
      "id": "whispercpp",
      "displayName": "Whisper on this device",
      "kind": "local",
      "platforms": ["macos", "windows"],
      "autoLanguage": true,
      "verbatim": false,
      "timing": "dtw",
      "privacy": "onDevice",
      "sends": "Nothing. Runs on this device.",
      "runtime": {
        "macos": {
          "library": "whisper.cpp",
          "version": "1.9.5",
          "artifact": "whisper-b5454-xcframework.zip",
          "url": "https://github.com/ggml-org/whisper.cpp/releases/download/b5454/whisper-b5454-xcframework.zip",
          "bytes": 65816082,
          "swiftpmChecksum": "e57f8c48933000acabc13bb913fbe82805d483a2deff692cc6738836bd92393b",
          "license": "MIT",
          "acceleration": "Metal (shaders embedded), Accelerate; Core ML encoder support compiled in with fallback, unused in v1",
          "swiftpmTargetName": "whisper",
          "linkage": "dynamic framework; bundle.sh embeds it in Contents/Frameworks and signs it"
        },
        "windows": {
          "library": "Whisper.net",
          "version": "1.9.1",
          "whisperCppVersion": "1.8.5",
          "packages": [
            { "id": "Whisper.net", "version": "1.9.1" },
            { "id": "Whisper.net.Runtime", "version": "1.9.1", "rids": ["win-x64", "win-arm64"], "note": "CPU. Needs AVX, AVX2, FMA and F16C on x64." },
            { "id": "Whisper.net.Runtime.NoAvx", "version": "1.9.1", "rids": ["win-x64"], "note": "CPU fallback for x64 machines without AVX2." },
            { "id": "Whisper.net.Runtime.Vulkan", "version": "1.9.1", "rids": ["win-x64"], "note": "GPU on AMD, Intel and NVIDIA through the driver's Vulkan loader. No win-arm64 build exists." }
          ],
          "license": "MIT"
        }
      }
    },
    {
      "id": "apple-speech",
      "displayName": "Apple Speech (on this Mac)",
      "kind": "system",
      "platforms": ["macos"],
      "minimumOS": "26.0",
      "module": "SpeechTranscriber",
      "autoLanguage": false,
      "verbatim": false,
      "timing": "runGrouped",
      "privacy": "onDevice",
      "sends": "Nothing. macOS downloads its own speech assets.",
      "localesAuthority": "runtime: SpeechTranscriber.supportedLocales and supportedLocale(equivalentTo:)",
