{
  "$description": "VoxClip design tokens. Source of truth for both apps. Generated outputs: apps/macos/Sources/VoxClip/Design/Tokens.swift and apps/windows/src/VoxClip.App/Themes/Tokens.xaml (tools/design). Spec: doc/design.md section 16.",
  "$extensions": {
    "com.voxconvo.voxclip": {
      "format": "voxclip-tokens/1",
      "version": 1,
      "modes": ["dark", "light"],
      "heroMode": "dark",
      "conventions": {
        "syntax": "W3C Design Tokens group/token syntax ($type, $value, $description). Colour tokens are the exception: $value is a mode map {dark, light}.",
        "color": "#RRGGBB or #RRGGBBAA, sRGB, straight (non-premultiplied) alpha.",
        "system": "A value of the form system:<name> means the platform colour named in $extensions.com.voxconvo.voxclip.macos / .windows; the generator must not substitute a hex value.",
        "highContrast": "windowsHighContrast names the WinUI SystemColor* resource used in the HighContrast theme dictionary. macOS relies on Increase Contrast and the system colours.",
        "units": "Lengths are points on macOS and effective pixels (epx) on Windows. Durations are milliseconds."
      }
    }
  },
  "color": {
    "bg": {
      "window": {
        "$type": "color",
        "$value": { "dark": "#0B0C0F", "light": "#F0F0ED" },
        "$description": "Behind content. On macOS system chrome draws its own glass over it. Windows: Mica shows through instead; use only as the Mica fallback colour.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor", "source": "VoxConvo --ink / titanium 100" } }
      },
      "surface": {
        "$type": "color",
        "$value": { "dark": "#121317", "light": "#FAFAF8" },
        "$description": "Transcript sheet and other long-reading content surfaces.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor", "source": "recorder console bg / titanium 50" } }
      },
      "elevated": {
        "$type": "color",
        "$value": { "dark": "#1D1F25", "light": "#FEFEFD" },
        "$description": "Caption tiles, popover fallback, onboarding cards.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorButtonFaceColor" } }
      },
      "muted": {
        "$type": "color",
        "$value": { "dark": "#28292F", "light": "#E1E2E6" },
        "$description": "Hover and pressed rows.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorButtonFaceColor" } }
      },
      "input": {
        "$type": "color",
        "$value": { "dark": "#15161B", "light": "#FFFFFF" },
        "$description": "Custom input backgrounds only. System text fields keep their own fill.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor" } }
      }
    },
    "line": {
      "default": {
        "$type": "color",
        "$value": { "dark": "#2B2C33", "light": "#D9DAD8" },
        "$description": "Hairline dividers (clip rows, inspector sections).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "subtle": {
        "$type": "color",
        "$value": { "dark": "#24252A", "light": "#E7E8EA" },
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "strong": {
        "$type": "color",
        "$value": { "dark": "#42444B", "light": "#C3C5CD" },
        "$description": "Borders on custom surfaces under Reduce Transparency / Increase Contrast.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": { "dark": "#F3F0E7", "light": "#131419" },
        "$description": "Body and transcript text. Contrast on bg.surface: dark 16.3:1, light 17.6:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "secondary": {
        "$type": "color",
        "$value": { "dark": "#DEDEDB", "light": "#363840" },
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "muted": {
        "$type": "color",
        "$value": { "dark": "#B0B3BD", "light": "#51545F" },
        "$description": "Helper text, clip reasons, pause token text. Contrast on bg.surface: dark 8.9:1, light 7.2:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "tertiary": {
        "$type": "color",
        "$value": { "dark": "#A4A7B0", "light": "#6B6F80" },
        "$description": "Mono caps status labels. Light value darkened from titanium 600 to reach 4.8:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "disabled": {
        "$type": "color",
        "$value": { "dark": "#777C8D", "light": "#9396A4" },
        "$description": "Disabled labels only (exempt from contrast minimums).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorGrayTextColor" } }
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": { "dark": "#ECE9DF", "light": "#21232B" },
        "$description": "The one neutral accent: selected choice fill, custom focus ring, clip number badge. macOS AccentColor asset uses this value; Windows keeps the system accent for AccentButtonStyle and focus visuals.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor", "source": "titanium 300 / 900" } }
      },
      "on": {
        "$type": "color",
        "$value": { "dark": "#0E0E11", "light": "#FAFAF8" },
        "$description": "Text and glyphs on accent.default. Contrast 15.9:1 / 15.0:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightTextColor" } }
      }
    },
    "selection": {
      "text": {
        "$type": "color",
        "$value": { "dark": "system:selectedText", "light": "system:selectedText" },
        "$description": "Transcript selection. Always the platform selection colour.",
        "$extensions": { "com.voxconvo.voxclip": { "macos": "NSColor.selectedTextBackgroundColor", "windows": "SystemAccentColor at 40% opacity", "windowsHighContrast": "SystemColorHighlightColor" } }
      }
    },
    "word": {
      "playingBackground": {
        "$type": "color",
        "$value": { "dark": "#F3F0E7", "light": "#21232B" },
        "$description": "Fill behind the currently playing word (radius.xs, 2 pt inline padding).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor", "source": "VoxConvo WordChip playing state" } }
      },
      "playingForeground": {
        "$type": "color",
        "$value": { "dark": "#0E0E11", "light": "#FAFAF8" },
        "$description": "Text of the playing word. Contrast 16.9:1 / 15.0:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightTextColor" } }
      },
      "cut": {
        "$type": "color",
        "$value": { "dark": "#9599A6", "light": "#6E717D" },
        "$description": "Text of cut words (still content, kept at >= 4.5:1: dark 6.5:1, light 4.65:1).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorGrayTextColor" } }
      },
      "lowConfidence": {
        "$type": "color",
        "$value": { "dark": "#B0B3BD80", "light": "#51545F80" },
        "$description": "Dashed underline for low-confidence words (off by default).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "correctionDot": {
        "$type": "color",
        "$value": { "dark": "#B0B3BD", "light": "#51545F" },
        "$description": "2 pt dot under the first letter of a corrected word.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      }
    },
    "cut": {
      "stroke": {
        "$type": "color",
        "$value": { "dark": "#F38F83B3", "light": "#C4453FD9" },
        "$description": "Strikethrough line on cut words (macOS; Windows strikes in word.cut because XAML text decorations use the foreground). Composite contrast on bg.surface: dark 4.5:1, light 3.7:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorGrayTextColor", "source": "VoxConvo destructive #F38F83 / Superscribe softRed" } }
      },
      "fill": {
        "$type": "color",
        "$value": { "dark": "#F38F838C", "light": "#C4453FE6" },
        "$description": "Timeline hatch stripes for cut word ranges (2 pt stripes every 6 pt at 45 degrees). Composite on timeline.track: dark 3.1:1, light 3.4:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor" } }
      },
      "pauseFill": {
        "$type": "color",
        "$value": { "dark": "#B0B3BD59", "light": "#51545F59" },
        "$description": "Timeline hatch stripes for cut pause ranges.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorGrayTextColor" } }
      }
    },
    "pause": {
      "background": {
        "$type": "color",
        "$value": { "dark": "#2C2E35", "light": "#E7E8EA" },
        "$description": "Inline pause token and the collapsed '... 5 cut' token. Token text uses text.muted (6.5:1 / 6.2:1).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorButtonFaceColor" } }
      }
    },
    "status": {
      "warning": {
        "$type": "color",
        "$value": { "dark": "#F2C46B", "light": "#9E6600" },
        "$description": "Suggested-filler dotted underline and slow states. Contrast 11.4:1 / 4.6:1.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHotlightColor", "source": "Superscribe Theme.warning" } }
      },
      "dangerForeground": {
        "$type": "color",
        "$value": { "dark": "#F3ABAB", "light": "#B4232A" },
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "dangerBackground": {
        "$type": "color",
        "$value": { "dark": "#271B20", "light": "#FCEDEE" },
        "$description": "Custom error rows only; Windows uses InfoBar severity colours instead.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor" } }
      },
      "success": {
        "$type": "color",
        "$value": { "dark": "system:green", "light": "system:green" },
        "$extensions": { "com.voxconvo.voxclip": { "macos": "NSColor.systemGreen", "windows": "SystemFillColorSuccessBrush", "windowsHighContrast": "SystemColorWindowTextColor" } }
      }
    },
    "record": {
      "button": {
        "$type": "color",
        "$value": { "dark": "#E5484D", "light": "#E5484D" },
        "$description": "Record button dot (M2).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor" } }
      },
      "live": {
        "$type": "color",
        "$value": { "dark": "#FF5C5C", "light": "#FF5C5C" },
        "$description": "Blinking REC dot (M2).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor" } }
      }
    },
    "timeline": {
      "track": {
        "$type": "color",
        "$value": { "dark": "#1A1B20", "light": "#E1E2E6" },
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor" } }
      },
      "kept": {
        "$type": "color",
        "$value": { "dark": "#3A3C45", "light": "#C3C5CD" },
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorButtonFaceColor" } }
      },
      "waveform": {
        "$type": "color",
        "$value": { "dark": "#B0B3BD59", "light": "#51545F59" },
        "$description": "Optional RMS waveform over kept speech (50 ms buckets).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "clipBracket": {
        "$type": "color",
        "$value": { "dark": "#F3F0E7CC", "light": "#131419CC" },
        "$description": "2 pt clip bracket line above the track.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "clipBand": {
        "$type": "color",
        "$value": { "dark": "#ECE9DF1F", "light": "#21232B1F" },
        "$description": "Band behind the active clip range.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor" } }
      },
      "playhead": {
        "$type": "color",
        "$value": { "dark": "#F3F0E7", "light": "#131419" },
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor" } }
      }
    },
    "stage": {
      "$type": "color",
      "$value": { "dark": "#000000", "light": "#000000" },
      "$description": "Video surround in both appearances and in High Contrast. The only pure black allowed.",
      "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "#000000" } }
    },
    "overlay": {
      "scrim": {
        "$type": "color",
        "$value": { "dark": "#0D0E11C7", "light": "#0D0E11C7" },
        "$description": "REC pill and other chips drawn over video (78%).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor" } }
      },
      "transportOpaque": {
        "$type": "color",
        "$value": { "dark": "#0D0E11EB", "light": "#0D0E11EB" },
        "$description": "Transport pill fill under Reduce Transparency (92%), with line.strong border.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor" } }
      },
      "drop": {
        "$type": "color",
        "$value": { "dark": "#121317EB", "light": "#FAFAF8EB" },
        "$description": "'Drop to transcribe' overlay background.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowColor" } }
      },
      "dropBorder": {
        "$type": "color",
        "$value": { "dark": "#F3F0E7", "light": "#131419" },
        "$description": "2 pt dashed border of the drop overlay.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      },
      "dropZoneBorder": {
        "$type": "color",
        "$value": { "dark": "#F3F0E766", "light": "#13141966" },
        "$description": "2 pt dashed border of the Welcome drop zone (40%).",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorWindowTextColor" } }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": { "dark": "#ECE9DF", "light": "#21232B" },
        "$description": "Custom-drawn focus rings only (2 pt, offset 2). System controls keep the system ring / focus visual.",
        "$extensions": { "com.voxconvo.voxclip": { "windowsHighContrast": "SystemColorHighlightColor" } }
      }
    }
  },
  "typography": {
    "status": {
      "$type": "typography",
      "$description": "Mono caps status labels (READY TO REVIEW style), gutter labels.",
      "$value": {
        "macos": { "fontFamily": "Geist Mono", "fontWeight": 400, "fontSize": 10, "lineHeight": 14, "letterSpacing": 0.65, "textCase": "upper", "features": ["tnum"] },
        "windows": { "fontFamily": "Geist Mono", "fontWeight": 400, "fontSize": 11, "lineHeight": 16, "letterSpacing": 0.65, "textCase": "upper", "features": ["tnum"] }
      }
    },
    "caption": {
      "$type": "typography",
      "$description": "Helper text, tile names.",
      "$value": {
        "macos": { "fontFamily": "system", "fontWeight": 400, "fontSize": 10, "lineHeight": 13, "systemStyle": "caption" },
        "windows": { "fontFamily": "system", "fontWeight": 400, "fontSize": 12, "lineHeight": 16, "systemStyle": "CaptionTextBlockStyle" }
      }
    },
    "footnote": {
      "$type": "typography",
      "$description": "Clip reasons, meta lines.",
      "$value": {
        "macos": { "fontFamily": "system", "fontWeight": 400, "fontSize": 11, "lineHeight": 14, "systemStyle": "subheadline" },
        "windows": { "fontFamily": "system", "fontWeight": 400, "fontSize": 12, "lineHeight": 16, "systemStyle": "CaptionTextBlockStyle" }
      }
    },
    "body": {
      "$type": "typography",
      "$description": "All UI text.",
      "$value": {
        "macos": { "fontFamily": "system", "fontWeight": 400, "fontSize": 13, "lineHeight": 17, "systemStyle": "body" },
        "windows": { "fontFamily": "system", "fontWeight": 400, "fontSize": 14, "lineHeight": 20, "systemStyle": "BodyTextBlockStyle" }
      }
    },
    "bodyStrong": {
      "$type": "typography",
      "$description": "Labels, clip titles.",
      "$value": {
        "macos": { "fontFamily": "system", "fontWeight": 600, "fontSize": 13, "lineHeight": 17, "systemStyle": "headline" },
        "windows": { "fontFamily": "system", "fontWeight": 600, "fontSize": 14, "lineHeight": 20, "systemStyle": "BodyStrongTextBlockStyle" }
      }
    },
    "section": {
      "$type": "typography",
      "$description": "Inspector section titles (Captions, Clips).",
      "$value": {
        "macos": { "fontFamily": "system", "fontWeight": 600, "fontSize": 15, "lineHeight": 20, "systemStyle": "title3" },
        "windows": { "fontFamily": "system", "fontWeight": 600, "fontSize": 20, "lineHeight": 28, "systemStyle": "SubtitleTextBlockStyle" }
      }
    },
    "title": {
      "$type": "typography",
      "$description": "Welcome and onboarding headline.",
      "$value": {
        "macos": { "fontFamily": "system", "fontWeight": 600, "fontSize": 22, "lineHeight": 28, "letterSpacing": -0.4, "systemStyle": "title" },
        "windows": { "fontFamily": "system", "fontWeight": 600, "fontSize": 28, "lineHeight": 36, "systemStyle": "TitleTextBlockStyle" }
      }
    },
    "transcript": {
      "$type": "typography",
      "$description": "Transcript body. Zoom 13-28 pt (macOS) / 13-28 epx (Windows) in steps of 1, line height = size x 1.65 rounded.",
      "$value": {
        "macos": { "fontFamily": "DM Sans", "fontWeight": 400, "fontSize": 17, "lineHeight": 28, "zoomMin": 13, "zoomMax": 28, "lineHeightMultiplier": 1.65 },
        "windows": { "fontFamily": "DM Sans", "fontWeight": 400, "fontSize": 16, "lineHeight": 26, "zoomMin": 13, "zoomMax": 28, "lineHeightMultiplier": 1.65 }
      }
    },
    "pauseToken": {
      "$type": "typography",
      "$description": "Inline pause token text ('|| 1.4s').",
      "$value": {
        "macos": { "fontFamily": "Geist Mono", "fontWeight": 400, "fontSize": 11, "lineHeight": 14, "features": ["tnum"] },
        "windows": { "fontFamily": "Geist Mono", "fontWeight": 400, "fontSize": 11, "lineHeight": 16, "features": ["tnum"] }
      }
    },
    "timecode": {
      "$type": "typography",
      "$description": "Gutter timecodes and timeline labels, mm:ss.d.",
      "$value": {
        "macos": { "fontFamily": "Geist Mono", "fontWeight": 500, "fontSize": 12, "lineHeight": 16, "features": ["tnum"] },
        "windows": { "fontFamily": "Geist Mono", "fontWeight": 500, "fontSize": 12, "lineHeight": 16, "features": ["tnum"] }
      }
    },
    "transport": {
      "$type": "typography",
      "$description": "Transport pill time.",
      "$value": {
        "macos": { "fontFamily": "Geist Mono", "fontWeight": 600, "fontSize": 15, "lineHeight": 20, "features": ["tnum"] },
        "windows": { "fontFamily": "Geist Mono", "fontWeight": 600, "fontSize": 16, "lineHeight": 20, "features": ["tnum"] }
      }
    }
  },
  "fontFiles": {
    "$description": "Brand fonts used by the UI (transcript and numbers). Files live in shared/fonts/<family>/ with entries in shared/fonts/fonts.json, added through tools/captions/font-sources.json like the caption fonts. 'present' records whether the file is bundled as of 2026-10-25. Until a file is present the apps use the platform fallback named here, so the UI never depends on a missing file.",
    "dmSans": { "$type": "fontFamily", "$value": "DM Sans", "$extensions": { "com.voxconvo.voxclip": { "files": { "dm-sans/DMSans-Regular.ttf": { "weight": 400, "present": false }, "dm-sans/DMSans-Medium.ttf": { "weight": 500, "present": true } }, "licence": "OFL-1.1", "fallbackMacos": "SF Pro", "fallbackWindows": "Segoe UI Variable" } } },
    "geistMono": { "$type": "fontFamily", "$value": "Geist Mono", "$extensions": { "com.voxconvo.voxclip": { "files": { "geist-mono/GeistMono-Regular.ttf": { "weight": 400, "present": false }, "geist-mono/GeistMono-Medium.ttf": { "weight": 500, "present": false }, "geist-mono/GeistMono-SemiBold.ttf": { "weight": 600, "present": false } }, "licence": "OFL-1.1", "fallbackMacos": "SF Mono", "fallbackWindows": "Cascadia Mono" } } }
  },
  "spacing": {
    "$description": "4-point grid.",
    "0": { "$type": "dimension", "$value": 0 },
    "1": { "$type": "dimension", "$value": 2 },
    "2": { "$type": "dimension", "$value": 4 },
    "3": { "$type": "dimension", "$value": 8 },
    "4": { "$type": "dimension", "$value": 12 },
    "5": { "$type": "dimension", "$value": 16 },
    "6": { "$type": "dimension", "$value": 20 },
    "7": { "$type": "dimension", "$value": 24 },
    "8": { "$type": "dimension", "$value": 32 },
    "9": { "$type": "dimension", "$value": 48 },
    "panePaddingMacos": { "$type": "dimension", "$value": 20 },
    "panePaddingWindows": { "$type": "dimension", "$value": 24 },
    "inspectorRowGap": { "$type": "dimension", "$value": 8 },
    "inspectorSectionGap": { "$type": "dimension", "$value": 20 },
    "tileGap": { "$type": "dimension", "$value": 8 },
    "clipRowPadding": { "$type": "dimension", "$value": 12 },
    "transcriptParagraphGap": { "$type": "dimension", "$value": 12 },
    "transcriptGutter": { "$type": "dimension", "$value": 64 },
    "wordHitSlopVertical": { "$type": "dimension", "$value": 2 }
  },
  "radius": {
    "xs": { "$type": "dimension", "$value": 4, "$description": "Playing-word fill, timeline track, Windows ControlCornerRadius." },
    "sm": { "$type": "dimension", "$value": 6, "$description": "Pause and collapsed-cut tokens, keycaps, number badges." },
    "md": { "$type": "dimension", "$value": 8, "$description": "Chips, inputs, Windows OverlayCornerRadius (cards, panes)." },
    "lg": { "$type": "dimension", "$value": 12, "$description": "Video stage, caption tiles. macOS 26: .containerConcentric with this as fallback." },
    "xl": { "$type": "dimension", "$value": 16, "$description": "Drop zone, onboarding sheet." },
    "full": { "$type": "dimension", "$value": 9999, "$description": "Capsule: transport pill, REC pill." }
  },
  "stroke": {
    "cutStrike": { "$type": "dimension", "$value": 1.5 },
    "focusRing": { "$type": "dimension", "$value": 2 },
    "focusRingOffset": { "$type": "dimension", "$value": 2 },
    "playhead": { "$type": "dimension", "$value": 2 },
    "playheadHead": { "$type": "dimension", "$value": 7, "$description": "Triangle head size." },
    "clipBracket": { "$type": "dimension", "$value": 2 },
    "selectedTileBorder": { "$type": "dimension", "$value": 2 },
