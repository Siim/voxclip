{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Siim/voxclip/main/shared/schemas/autopilot-picture-cases.schema.json",
  "title": "voxclip-cli autopilot frames and picture vectors (ADR-R48 part 2, package W6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "description", "caseCount", "cases"],
  "properties": {
    "schema": {"const": "voxclip-autopilot-picture-cases/1"},
    "description": {"type": "string", "minLength": 1},
    "caseCount": {"type": "integer", "minimum": 1},
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "note", "sent", "reply", "decisions", "shapes", "faceFound", "frames", "picture"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "sent": {
            "type": "object", "additionalProperties": false, "required": ["frames", "images", "imageTokens", "blur", "cover"],
            "properties": {
              "frames": {"type": "integer", "minimum": 0},
              "images": {"type": "boolean"},
              "imageTokens": {"type": "integer", "minimum": 0},
              "blur": {"type": "array", "items": {"$ref": "#/$defs/blurCandidate"}},
              "cover": {"type": "array", "items": {"$ref": "#/$defs/coverCandidate"}}
            }
          },
          "reply": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false, "required": ["blur", "cover"],
                "properties": {
                  "blur": {
                    "type": "array",
                    "items": {
                      "type": "object", "additionalProperties": false, "required": ["id", "blur", "reason"],
                      "properties": {"id": {"type": "string"}, "blur": {"type": "boolean"}, "reason": {"type": "string"}}
                    }
                  },
                  "cover": {
                    "oneOf": [
                      {"type": "null"},
                      {
                        "type": "object", "additionalProperties": false, "required": ["id", "reason", "fallback"],
                        "properties": {"id": {"type": "string"}, "reason": {"type": "string"}, "fallback": {"type": "boolean"}}
                      }
                    ]
                  }
                }
              }
            ]
          },
          "decisions": {
            "type": "object", "additionalProperties": false, "required": ["opening", "crop", "blurs", "cover"],
            "properties": {
              "opening": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false, "required": ["leadIn", "earlier", "start", "chosen", "reason"],
                    "properties": {
                      "leadIn": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.6}, "earlier": {"type": "number", "exclusiveMinimum": 0},
                      "start": {"type": "number", "minimum": 0}, "chosen": {"type": "number", "minimum": 0}, "reason": {"type": "string", "minLength": 1}
                    }
                  }
                ]
              },
              "crop": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false, "required": ["centerX", "centerY"],
                    "properties": {"centerX": {"type": "number", "minimum": 0, "maximum": 1}, "centerY": {"type": "number", "minimum": 0, "maximum": 1}}
                  }
                ]
              },
              "blurs": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "blurred", "reason"],
                  "properties": {"id": {"type": "string"}, "blurred": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}
                }
              },
              "cover": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false, "required": ["id", "named", "reason"],
                    "properties": {"id": {"type": "string"}, "named": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}
                  }
                ]
              }
            }
          },
          "shapes": {"type": "array", "minItems": 1, "items": {"enum": ["16:9", "9:16", "1:1"]}},
          "faceFound": {"type": "boolean"},
          "frames": {
            "type": "object", "additionalProperties": false, "required": ["sent", "images", "imageTokens", "blur", "cover"],
            "properties": {
              "sent": {"type": "integer"}, "images": {"type": "boolean"}, "imageTokens": {"type": "integer"},
              "blur": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "start", "end"],
                  "properties": {"id": {"type": "string"}, "start": {"type": "number"}, "end": {"type": "number"}}
                }
              },
              "cover": {"type": ["number", "null"]}
            }
          },
          "picture": {
            "type": "object", "additionalProperties": false, "required": ["opening", "crop", "blur", "cover"],
            "properties": {
              "opening": {
                "oneOf": [
                  {
                    "type": "object", "additionalProperties": false, "required": ["shift", "leadIn", "start", "frame", "reason"],
                    "properties": {
                      "shift": {"type": "number", "exclusiveMaximum": 0}, "leadIn": {"type": "number"}, "start": {"type": "number"},
                      "frame": {"type": "number"}, "reason": {"type": "string"}
                    }
                  },
                  {
                    "type": "object", "additionalProperties": false, "required": ["shift", "reason"],
                    "properties": {"shift": {"const": 0}, "reason": {"type": "null"}}
                  }
                ]
              },
              "crop": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false, "required": ["aspect", "faceFound", "center"],
                    "properties": {
                      "aspect": {"enum": ["9:16", "1:1"]}, "faceFound": {"type": "boolean"},
                      "center": {
                        "oneOf": [
                          {"type": "null"},
                          {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}}
                        ]
                      }
                    }
                  }
                ]
              },
              "blur": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["id", "start", "end", "blurred", "reason"],
                  "properties": {
                    "id": {"type": "string"}, "start": {"type": "number"}, "end": {"type": "number"}, "blurred": {"type": "boolean"},
                    "reason": {"type": ["string", "null"]}
                  }
                }
              },
              "cover": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object", "additionalProperties": false, "required": ["id", "time", "fallback", "reason"],
                    "properties": {"id": {"type": "string"}, "time": {"type": "number"}, "fallback": {"type": "boolean"}, "reason": {"type": ["string", "null"]}}
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}}
    },
    "blurCandidate": {
      "type": "object", "additionalProperties": false, "required": ["id", "start", "end", "rect", "frames"],
      "properties": {
        "id": {"type": "string", "pattern": "^B[0-9]+$"}, "start": {"type": "number"}, "end": {"type": "number"},
        "rect": {"$ref": "#/$defs/rect"}, "frames": {"type": "integer", "minimum": 1}
      }
    },
    "coverCandidate": {
      "type": "object", "additionalProperties": false, "required": ["id", "frame", "time", "score"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[1-3]$"}, "frame": {"type": "integer", "minimum": 1}, "time": {"type": "number"}, "score": {"type": "number"}
      }
    }
  }
}
