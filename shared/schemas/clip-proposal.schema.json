{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Siim/voxclip/main/shared/schemas/clip-proposal.schema.json",
  "title": "VoxClip canonical clip proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "description": "An existing clip id from read_clips."
        },
        "new": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "stretch",
                "story",
                "showreel"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "kind",
            "title"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "clipId"
          ]
        },
        {
          "required": [
            "new"
          ]
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startWord": {
            "type": "integer",
            "minimum": 0
          },
          "endWord": {
            "type": "integer",
            "minimum": 0
          },
          "takeReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "startWord",
          "endWord"
        ]
      }
    },
    "cuts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startWord": {
            "type": "integer",
            "minimum": 0
          },
          "endWord": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "filler",
              "stumble",
              "repeat",
              "falseStart",
              "tangent",
              "other"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "startWord",
          "endWord",
          "kind",
          "reason"
        ]
      }
    },
    "pauseCuts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "afterWord": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "afterWord",
          "reason"
        ]
      }
    },
    "corrections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "word": {
            "type": "integer",
            "minimum": 0
          },
          "heard": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "word",
          "heard",
          "text",
          "reason"
        ]
      }
    },
    "captionStyle": {
      "type": "string",
      "minLength": 1
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        }
      },
      "required": [
        "family",
        "weight"
      ]
    },
    "case": {
      "enum": [
        "upper",
        "lower",
        "asSaid"
      ]
    },
    "wordsPerCaption": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "original",
            "muted",
            "warm",
            "bw"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "id"
      ]
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "rate"
      ]
    },
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "postText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "coverTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trackId": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "fadeIn": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "fadeOut": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "duckDb": {
          "type": "number",
          "minimum": -24,
          "maximum": 0
        },
        "segments": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "startWord": {
                "type": "integer",
                "minimum": 0
              },
              "endWord": {
                "type": "integer",
                "minimum": 0
              },
              "songFrom": {
                "type": "number",
                "minimum": 0,
                "maximum": 1800
              },
              "loop": {
                "type": "boolean"
              },
              "gainDb": {
                "type": "number",
                "minimum": -40,
                "maximum": 12
              },
              "fadeIn": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "fadeOut": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "startWord",
              "endWord"
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "trackId"
          ]
        },
        {
          "required": [
            "brief"
          ]
        }
      ]
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "clip-plan-effect.schema.json"
      }
    },
    "rewrites": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startWord": {
            "type": "integer",
            "minimum": 0
          },
          "endWord": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "startWord",
          "endWord",
          "text",
          "reason"
        ]
      }
    }
  },
  "required": [
    "target",
    "reason"
  ],
  "anyOf": [
    {
      "required": [
        "parts"
      ]
    },
    {
      "required": [
        "cuts"
      ]
    },
    {
      "required": [
        "pauseCuts"
      ]
    },
    {
      "required": [
        "corrections"
      ]
    },
    {
      "required": [
        "captionStyle"
      ]
    },
    {
      "required": [
        "font"
      ]
    },
    {
      "required": [
        "case"
      ]
    },
    {
      "required": [
        "wordsPerCaption"
      ]
    },
    {
      "required": [
        "look"
      ]
    },
    {
      "required": [
        "speed"
      ]
    },
    {
      "required": [
        "hook"
      ]
    },
    {
      "required": [
        "title"
      ]
    },
    {
      "required": [
        "postText"
      ]
    },
    {
      "required": [
        "coverTitle"
      ]
    },
    {
      "required": [
        "music"
      ]
    },
    {
      "required": [
        "effects"
      ]
    },
    {
      "required": [
        "rewrites"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "required": [
              "new"
            ]
          }
        }
      },
      "then": {
        "required": [
          "parts"
        ],
        "if": {
          "properties": {
            "target": {
              "properties": {
                "new": {
                  "properties": {
                    "kind": {
                      "const": "stretch"
                    }
                  }
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "parts": {
              "maxItems": 1
            }
          }
        },
        "else": {
          "properties": {
            "parts": {
              "minItems": 2
            }
          }
        }
      }
    }
  ]
}
