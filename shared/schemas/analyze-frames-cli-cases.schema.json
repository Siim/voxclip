{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Siim/voxclip/main/shared/schemas/analyze-frames-cli-cases.schema.json",
  "title": "voxclip-cli analyze-frames output vectors (ADR-R48, package W5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "description", "version", "caseCount", "counts", "reports", "numbers"],
  "properties": {
    "schema": {"const": "voxclip-analyze-frames-cli-cases/1"},
    "description": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "caseCount": {"type": "integer", "minimum": 1},
    "counts": {
      "type": "object", "additionalProperties": false, "required": ["reports", "numbers"],
      "properties": {"reports": {"type": "integer", "minimum": 1}, "numbers": {"type": "integer", "minimum": 1}}
    },
    "reports": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "note", "words", "clip", "video", "analysis", "sheet", "videoPass", "json"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1},
          "words": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "text", "kind", "start", "end"],
              "properties": {
                "id": {"type": "string", "minLength": 1}, "text": {"type": "string"}, "kind": {"enum": ["word", "event"]},
                "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0}
              }
            }
          },
          "clip": {
            "type": "object", "additionalProperties": false, "required": ["first", "last", "cut"],
            "properties": {
              "first": {"type": "integer", "minimum": 0}, "last": {"type": "integer", "minimum": 0},
              "cut": {"type": "array", "items": {"type": "string"}}
            }
          },
          "video": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false, "required": ["width", "height", "rotationDegrees"],
                "properties": {
                  "width": {"type": "integer", "minimum": 0}, "height": {"type": "integer", "minimum": 0},
                  "rotationDegrees": {"enum": [0, 90, 180, 270]}
                }
              }
            ]
          },
          "analysis": {
            "type": "object", "additionalProperties": false, "required": ["contentKey", "sentences", "opening", "timings", "version"],
            "properties": {
              "contentKey": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "sentences": {"type": "array", "items": {"type": "object"}},
              "opening": {"type": "array", "items": {"type": "object"}},
              "timings": {
                "type": "object", "additionalProperties": false,
                "required": ["sentenceSeconds", "openingSeconds", "cachedFrames", "analyzedFrames"],
                "properties": {
                  "sentenceSeconds": {"type": "number", "minimum": 0}, "openingSeconds": {"type": "number", "minimum": 0},
                  "cachedFrames": {"type": "integer", "minimum": 0}, "analyzedFrames": {"type": "integer", "minimum": 0}
                }
              },
              "version": {"const": 2}
            }
          },
          "sheet": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["index", "sentence", "width", "height", "bytes"],
              "properties": {
                "index": {"type": "integer", "minimum": 1}, "sentence": {"type": "integer", "minimum": 0},
                "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
                "bytes": {"type": "integer", "minimum": 1}
              }
            }
          },
          "videoPass": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["read", "frames", "analyzed", "cached", "seconds", "clipFrames", "clipSeconds", "openingFrames",
                             "openingSeconds", "pitchBaseline"],
                "properties": {
                  "read": {"type": "boolean"}, "frames": {"type": "integer", "minimum": 0},
                  "analyzed": {"type": "integer", "minimum": 0}, "cached": {"type": "integer", "minimum": 0},
                  "seconds": {"type": "number", "minimum": 0}, "clipFrames": {"type": "integer", "minimum": 0},
                  "clipSeconds": {"type": "number", "minimum": 0}, "openingFrames": {"type": "integer", "minimum": 0},
                  "openingSeconds": {"type": "number", "minimum": 0}, "pitchBaseline": {"type": ["number", "null"]}
                }
              }
            ]
          },
          "json": {"type": "string", "pattern": "^\\{\"analysis\":.*\\}\\n$"}
        }
      }
    },
    "numbers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["value", "text"],
        "properties": {"value": {"type": "number"}, "text": {"type": "string", "minLength": 1}}
      }
    }
  }
}
