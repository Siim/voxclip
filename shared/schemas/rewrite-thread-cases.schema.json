{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Siim/voxclip/main/shared/schemas/rewrite-thread-cases.schema.json",
  "title": "Rewrite thread vectors (design.md section 6.3 Talk back to Claude, ai.md section 12.12, ADR-R50)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "promptSha256", "requestCount", "replyCount", "requests", "replies"],
  "properties": {
    "schema": {"const": "voxclip-rewrite-thread-cases/1"},
    "promptSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requestCount": {"type": "integer", "minimum": 1},
    "replyCount": {"type": "integer", "minimum": 1},
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"$ref": "#/$defs/input"},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["system", "cachedBlock", "instruction", "schemaName", "tag", "maxOutputTokens"],
            "properties": {
              "system": {"type": "string", "minLength": 1},
              "cachedBlock": {"type": "string", "minLength": 1},
              "instruction": {"type": "string", "minLength": 1},
              "schemaName": {"enum": ["rewrite_followup", "rewrite_followup_versions"]},
              "tag": {"enum": ["rewrite-followup", "rewrite-followup-versions"]},
              "maxOutputTokens": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "replies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input", "reply", "expect"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"$ref": "#/$defs/input"},
          "reply": {"type": "object"},
          "expect": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["texts", "note", "nextSteps"],
                "properties": {
                  "texts": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
                  "note": {"type": "string"},
                  "nextSteps": {"type": "array", "maxItems": 2, "items": {"type": "string", "minLength": 1}}
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["error"],
                "properties": {"error": {"const": "invalidOutput"}}
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "language", "source", "ordinal", "recorded", "versions", "messages"],
      "properties": {
        "kind": {"enum": ["reply", "versions"]},
        "scope": {"enum": ["passage", "clip", "fullTake"]},
        "language": {"type": "string", "minLength": 2},
        "source": {"type": "string", "minLength": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "recorded": {"type": "string"},
        "versions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "messages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
