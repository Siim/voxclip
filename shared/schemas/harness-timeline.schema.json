{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Siim/voxclip/main/shared/schemas/harness-timeline.schema.json",
  "title": "VoxClip harness timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["clipId", "reason"],
  "properties": {
    "clipId": {"type": "string", "minLength": 1, "description": "An existing clip id from read_clips."},
    "reason": {"type": "string", "minLength": 1, "maxLength": 240},
    "cuts": {"type": "array", "minItems": 1, "maxItems": 30, "items": {
      "type": "object", "additionalProperties": false, "required": ["startWord", "endWord", "kind", "reason"],
      "properties": {
        "startWord": {"type": "integer", "minimum": 0},
        "endWord": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["filler", "stumble", "repeat", "falseStart", "tangent", "other"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    }},
    "captionStyle": {"type": "string", "minLength": 1, "description": "A bundled caption style id, or off."},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "musicTrackId": {"type": "string", "minLength": 1, "description": "Reuse a saved track id from read_decisions. No download."},
    "generateMusic": {"type": "string", "minLength": 1, "maxLength": 500, "description": "A music brief for a separate priced action in VoxClip. Never sends or spends."},
    "effects": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"allOf": [
      {"$ref": "clip-plan-effect.schema.json"},
      {"properties": {"kind": {"enum": ["zoom", "punchIn", "motionTitle", "lowerThird", "emojiPop", "motionTemplate"]}}}
    ]}}
  },
  "anyOf": [
    {"required": ["cuts"]}, {"required": ["captionStyle"]}, {"required": ["title"]},
    {"required": ["musicTrackId"]}, {"required": ["generateMusic"]}, {"required": ["effects"]}
  ],
  "not": {"required": ["musicTrackId", "generateMusic"]}
}
